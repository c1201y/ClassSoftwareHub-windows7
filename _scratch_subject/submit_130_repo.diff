     private static string HumanSize(long bytes) => bytes switch
     {
         >= 1L << 30 => $"{bytes / 1073741824.0:0.##} GB",
         >= 1L << 20 => $"{bytes / 1048576.0:0.#} MB",
         >= 1L << 10 => $"{bytes / 1024.0:0.#} KB",
         _ => bytes + " B",
     };
 
