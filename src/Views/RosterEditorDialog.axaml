<fa:ContentDialog xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:fa="using:FluentAvalonia.UI.Controls"
                  x:Class="ClassSoftwareHub.Desktop.Views.RosterEditorDialog"
                  Title="名单"
                  CloseButtonText="关闭"
                  DefaultButton="Close"
                  CornerRadius="8">

    <!-- 2026-09-29（Nick 提："加一个 listview，方便预览哪些人，同时支持简单的修改"）。
         做成弹窗而不是就地摆在抽号页里，是**实测**决定的：
         本机窗口可用高度只有 617 DIP，抽号页内容行总共 ~300 —— 就地把 ListView 摆进去，
         实测被压到 19px 高（等于看不见）。弹窗能给它 400+ 的高度，一屏核对十几个人，
         而且不占主流程的地方。入口是参数行上一个写着「查看 / 编辑名单」的按钮，
         跟「导入名单」并排，不藏。

         ⚠️ 移植说明：宽度**必须**走主题资源 ContentDialogMaxWidth（ContentDialog 唯一的加宽办法，
            直接给内容设 Width / MaxWidth 都没用 —— FA 的模板里 BackgroundElement 的
            MaxWidth="{DynamicResource ContentDialogMaxWidth}"，默认约 548，会把内容钳死）。
            （2026-10-07 修正：本文件原来误判成"FA 没有这个资源键"，改用给内层 Grid 写死
              Width="720" —— 结果容器被默认上限钳在 548、内容硬要 720，整个弹窗挤成一坨、
              标题和正文重叠，Nick 实机截图反馈。现按上游 WinUI 版原样改回资源覆盖。）
         ⚠️ 移植说明：原版 Grid 的 ColumnSpacing / RowSpacing 改成子元素 Margin，间距值不变。 -->
    <fa:ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
    </fa:ContentDialog.Resources>

    <!-- ⚠️ 2026-10-07 加外层 ScrollViewer（上游没有）：ContentDialog 的正文不参与"超出就滚"，
         弹窗自身也不会被窗口裁 —— 正文比可用高度高时是**整块溢出**，连底部的「关闭」都被顶到窗口外，
         用户直接没法退出去。实测（2586×1210 物理 / 2× 缩放 = 605 逻辑高）：
         正文 380 的名单 + 表头 + 底部说明 ≈ 520，加标题与内边距就超了，
         「关闭」落在 y=1217（> 窗口底 1197），屏幕上看不见也点不着。
         套一层 ScrollViewer 后：高度够时它**完全不起作用**（样子与上游一致）；
         不够时正文整体可滚，而「关闭」在模板的按钮区（不在这层里），永远留在屏幕上。
         缩放 125% 的 1366×768 屏逻辑高只有 614，一样会踩到，所以这不是"小屏专用"的兜底。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 表头：人数 + 来源 + 导出 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" FontSize="13" FontWeight="Bold" Text="共 0 人" />
                    <TextBlock FontSize="11.5" Opacity="0.6" TextWrapping="Wrap"
                               Text="名字直接改：单击即可编辑，按回车或点别处生效；右侧按键移除这一行；「添加姓名」在末尾加人。" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
                    <!-- ⚠️ 2026-09-29 Nick 抓到：「只有删除没有增加，只删不增是吧？」
                         原来这排只有两个「导出」—— 用户能把人删掉，却没有任何办法加回来，
                         只能关掉弹窗去重新导入一份文件。加人这条路必须留在原地。
                         用 Accent 样式：导出是"带走结果"、加人是"改内容"，后者才是这张表的主要动作。 -->
                    <Button x:Name="AddNameButton" Click="Add_Click"
                            Theme="{StaticResource AccentButtonStyle}"
                            AutomationProperties.Name="添加一行姓名"
                            ToolTip.Tip="在名单末尾加一行，填好姓名后按回车即可">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <fa:FontIcon Glyph="&#xE710;" FontSize="13" />
                            <TextBlock Text="添加姓名" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportExcelButton" Content="导出 Excel" Click="ExportExcel_Click"
                            ToolTip.Tip="另存为 .xlsx 表格（序号 + 姓名两列）" />
                    <Button x:Name="ExportTxtButton" Content="导出 txt" Click="ExportTxt_Click"
                            ToolTip.Tip="另存为 .txt 文本，一行一个名字" />
                </StackPanel>
            </Grid>

            <!-- 名单本体。⚠️ 高度写死 + 内部滚动：名单最多 2000 人，弹窗不能跟着长
                 ⚠️ 原版 ListView 用 SelectionMode="None" 关掉选择 —— **Avalonia 没有这一档**
                    （SelectionMode 是 [Flags] 枚举，Single = 0 就是默认值，写 "None" 直接编译不过）。
                    名字那一格本身就是输入框，点它只为改名，不该在背后再选出一行高亮 ——
                    改成在 SelectionChanged 里当场把选择清掉（等价效果，见 .axaml.cs）。
                 ⚠️ 移植说明：原版 ListView.ItemContainerStyle（Padding/MinHeight 清零）在 Avalonia 的
                    ListBox 上没有一一对应物，改由行模板自身收紧内边距。 -->
            <ListBox x:Name="RosterList" Grid.Row="1" Height="380" Padding="0" Margin="0,10,0,0"
                     SelectionChanged="RosterList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding NoText}" FontSize="12" Opacity="0.55"
                                       VerticalAlignment="Center" />
                            <!-- 名字那一格**就是输入框**（不是"先点编辑再变输入框"）—— 少一步、不用猜哪儿能点。
                                 ⚠️ AutomationProperties.Name 必须给：不然读屏软件在这一格上读不出任何东西
                                    （输入框的 Name 是"标签"、Text 才是"内容"）。 -->
                            <TextBox Grid.Column="1" Text="{Binding Name}" FontSize="13" Padding="8,4"
                                     VerticalAlignment="Center" Margin="0,0,10,0"
                                     AutomationProperties.Name="{Binding RowLabel}"
                                     LostFocus="Name_LostFocus" KeyDown="Name_KeyDown" />
                            <Button Grid.Column="2" Click="Delete_Click" Padding="9,6"
                                    VerticalAlignment="Center" AutomationProperties.Name="{Binding DeleteLabel}"
                                    ToolTip.Tip="从名单中移除这一行">
                                <fa:FontIcon Glyph="&#xE74D;" FontSize="13" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 底部：空名单引导 + 说明
                 ⚠️「关闭」按钮由根节点上的 CloseButtonText 提供 —— 别以为它可有可无：
                    没有按钮的 ContentDialog 连"怎么退出去"都看不出来（Esc 也未必管用），
                    这一版实测就漏过一次，UIA 树里整个弹窗找不到任何退出入口。
                 编辑是"当场生效"的，所以**只有**关闭，没有确定 / 取消 —— 免得改了五十个名字点取消全丢。 -->
            <StackPanel Grid.Row="2" Spacing="6" Margin="0,10,0,0">
                <TextBlock x:Name="EmptyHint" FontSize="12.5" Opacity="0.6" TextWrapping="Wrap"
                           IsVisible="False"
                           Text="名单是空的。可以单击上方「添加姓名」逐个输入，也可以关闭本窗口后单击「导入名单」选择 Excel（.xlsx）或 txt / csv 文件；不清楚该怎么做，可先单击「示例名单」看一份现成的。" />
                <TextBlock x:Name="ToastText" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</fa:ContentDialog>
