<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClassSoftwareHub.Desktop.Views.Submit.SubmitWizardWindow"
        Title="提交软件"
        Width="880" Height="720" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">

    <!--
      投稿向导（自上游 dv1.2.2 移植，2026-11-14）。

      结构照本工程已有的 OOBE（Views/WelcomeWindow）：窗口只有「标题条 + 页面宿主 + 底部导航条」，
      步骤表与前进/后退在 SubmitSession 里，每一步是一个独立 UserControl（Steps/ 下）。

      ⚠️ 与 OOBE 的三处差别（别照搬那边的语义）：
        1. 关窗 = 存草稿，不是「结束并应用设置」；
        2. **非模态**，主窗口不隐藏（用户常要对照软件清单确认 ID 有没有撞车）；
        3. 提交成功停在结果页，不自动关窗，可继续提交下一个。

      ⚠️ 移植说明：
        · 上游的 Frame → 这里的 StepHost（页面实例自己缓存，往回翻时输入内容还在）；
        · 上游是自绘标题条，这里保留系统标题栏，顶部那行只作提示用
          （投稿窗口会被频繁开关，自绘标题栏的拖拽吸附在 Win7 上问题较多，不值得为它引入）；
        · ColumnSpacing 在 Avalonia 的 Grid 上不存在，用控件外边距代替。
    -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部提示条：标题 + 当前步骤 -->
        <Grid Grid.Row="0" Margin="24,14,24,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="提交软件" FontSize="13" Opacity="0.6" VerticalAlignment="Center" />
            <TextBlock x:Name="StepText" Grid.Column="1" FontSize="12" Opacity="0.6"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- 页面宿主：页面实例在这里缓存，往回翻时用户刚填的值还在 -->
        <Grid x:Name="StepHost" Grid.Row="1" ClipToBounds="True" Background="Transparent" />

        <!--
          底部导航条钉在窗口上、不跟页面滚动走：五个步骤的「上一步 / 下一步」始终在同一位置。
          左侧那行小字说明关窗不会丢内容 —— 用户不敢关窗，多半是怕白填。
        -->
        <Grid Grid.Row="2" Margin="24,8,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="FooterHint" VerticalAlignment="Center" FontSize="12" Opacity="0.55"
                       TextTrimming="CharacterEllipsis" Text="关闭窗口会自动保存草稿" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="BackNavButton" Content="上一步" MinWidth="96" IsVisible="False"
                        Click="NavBack_Click" />
                <Button x:Name="NextNavButton" Content="下一步" MinWidth="110" Classes="accent"
                        Click="NavNext_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
