<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        x:Class="ClassSoftwareHub.Desktop.Views.PptResumeWindow">

    <!--
      PPT 续播浮窗（2026-10-31）。

      用法：侧边栏「PPT 续播」模块 / 工具页的「打开浮窗」。
      自绘 32px 标题栏（与文件快搜、常用工具窗同一套）；× / Esc = 收起来。
      课间切到别的科目后，回到语文课点那颗「从上次那一页继续」就行。
    -->
    <Grid x:Name="Root" Focusable="True" KeyDown="Root_KeyDown"
          Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="32">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
                <fa:FontIcon Glyph="&#xE714;" FontSize="13" Opacity="0.85" />
                <TextBlock Text="PPT 续播" FontSize="12.5" VerticalAlignment="Center" />
            </StackPanel>

            <Button x:Name="PinButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="34" Height="28" Margin="0,0,84,0" Padding="0" MinWidth="0" BorderThickness="0"
                    Background="Transparent" ToolTip.Tip="始终置顶" Click="Pin_Click">
                <fa:FontIcon Glyph="&#xE718;" FontSize="13" />
            </Button>

            <Button x:Name="OpenPageButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="34" Height="28" Margin="0,0,50,0" Padding="0" MinWidth="0" BorderThickness="0"
                    Background="Transparent" ToolTip.Tip="在主界面打开完整页面"
                    Click="OpenPage_Click">
                <fa:FontIcon Glyph="&#xE8A7;" FontSize="13" />
            </Button>

            <Button x:Name="CaptionCloseButton" Classes="caption close"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,0,4,0" Click="CaptionClose_Click">
                <Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="18,8,18,14" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
            <TextBlock x:Name="LessonText" FontSize="12" Opacity="0.62" TextWrapping="Wrap" />

            <!--
              ⛔ 科目必须是**可选**的，不能只显示"程序猜当前是哪节课"。
              常遇到的场景：上一节数学没讲完，课间想先把数学那一页续上；
              或者临时调课 / 课表没导入，程序猜的科目跟你要续的不是同一个。
              下拉里列出「课表科目 + 有记录的科目」的并集，点谁就续谁。
            -->
            <ComboBox x:Name="SubjectCombo" Grid.Row="1"
                      FontSize="21" FontWeight="Bold" MinHeight="40"
                      Margin="0,2,0,0" HorizontalAlignment="Stretch"
                      SelectionChanged="SubjectCombo_SelectionChanged"
                      ToolTip.Tip="选择要续播的科目（不必是当前正在上的那节课）" />

            <TextBlock x:Name="FileText" Grid.Row="2" FontSize="12" Opacity="0.68"
                       TextWrapping="Wrap" Margin="0,2,0,0" />

            <TextBlock x:Name="SlideText" Grid.Row="3" FontSize="14" TextWrapping="Wrap"
                       Margin="0,4,0,0" />

            <StackPanel Grid.Row="4" VerticalAlignment="Top" Spacing="10" Margin="0,8,0,0">
                <Button x:Name="ResumeButton" Classes="accent" Content="从上次那一页继续"
                        Height="46" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        FontSize="14" Click="Resume_Click" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PickButton" Content="给这个科目选课件"
                            MinWidth="0" Padding="12,5" Click="Pick_Click" />
                    <Button x:Name="PageButton" Content="更多设置"
                            MinWidth="0" Padding="12,5" Click="OpenPage_Click" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="StatusText" Grid.Row="6" FontSize="11.5" Opacity="0.68"
                       TextWrapping="Wrap" MaxHeight="48" />
        </Grid>
    </Grid>
</Window>
