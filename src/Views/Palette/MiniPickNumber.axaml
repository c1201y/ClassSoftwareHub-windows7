<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             x:Class="ClassSoftwareHub.Desktop.Views.Palette.MiniPickNumber">

    <!--
      浮窗版随机抽号：抽什么（座号 / 名单）+ 基本设置 + 大号结果 + 重置/抽取/不重复。
      数据和「内置工具 → 随机抽号」共用同一个存档（%LOCALAPPDATA%\ClassSoftwareHub\pick-number.json），
      名单也是同一份 —— 在工具页导入，浮窗这边直接抽。

      2026-10-03（Nick 三轮定版，上游 dv1.1.0 增量）：
        · 「抽取座号」= 抽数字，「使用名单」= 抽名字。
        · **起始座号砍掉**：座号固定从 1 号开始，只留一个「终止范围」（＝原来那个"结束座号"）。
        · 「终止范围」和「抽取个数」改用 NumberBox（Inline 自增钮）——原来的小号上下箭头
          鼠标能点到、触屏点不到，Inline 版的上/下按钮整高、够大。
        · **不重复**挪到「重置 / 抽取」那一行的右边。

      ⚠️ RadioButton 的 IsChecked / 事件一律放 code-behind：XAML 里写 IsChecked="True"
      会在运行时抛 Failed to assign to property（见 MEMORY §8 的 CheckBox 坑）。
      ⚠️ 移植说明（WinUI → Avalonia）：
        · 原版 SelectorBar（本仓库按既有约定不使用，见 LogViewerPage 注释）→ 一排同 GroupName 的
          RadioButton 还原单选段控；代码里用 ModeRosterRadio.IsChecked 判模式，不做 SelectedItem 拨档；
        · ToggleSwitch.Toggled → IsCheckedChanged、IsOn → IsChecked；
        · NumberBox 用 FluentAvalonia 的 fa:NumberBox（本地既有用法，SpinButtonPlacementMode="Inline" 照搬）；
        · RowSpacing/ColumnSpacing → Margin；ToolTipService.ToolTip → ToolTip.Tip；
        · Visibility="Collapsed" → IsVisible="False"。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 抽什么：座号（数字）/ 名单（名字） -->
        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
            <RadioButton x:Name="ModeRangeRadio" Content="抽取座号" GroupName="MiniPoolMode"
                         MinWidth="0" Padding="6,0,0,0" />
            <RadioButton x:Name="ModeRosterRadio" Content="使用名单" GroupName="MiniPoolMode"
                         MinWidth="0" Padding="6,0,0,0" />
        </StackPanel>

        <!-- 基本设置一行：(终止范围 | 名单信息) + 抽取个数 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
            <!-- 座号模式：终止范围（从 1 号抽到 N 号） -->
            <fa:NumberBox x:Name="ToNumberBox" Header="终止范围" Value="50" Minimum="1" Maximum="9999"
                          SmallChange="1" SpinButtonPlacementMode="Inline" Width="150"
                          AutomationProperties.Name="终止范围" />

            <!-- 名单模式：池子信息（跟 NumberBox 的输入框本体育对齐） -->
            <TextBlock x:Name="RosterInfoText" FontSize="12.5" Opacity="0.7"
                       VerticalAlignment="Center" Margin="0,16,0,0"
                       Text="名单：—" TextWrapping="NoWrap" MaxWidth="150" />

            <!-- 抽取个数：两种模式共用（上限在代码里按模式夹） -->
            <fa:NumberBox x:Name="CountNumberBox" Header="抽取个数" Value="1" Minimum="1" Maximum="9999"
                          SmallChange="1" SpinButtonPlacementMode="Inline" Width="150"
                          AutomationProperties.Name="抽取个数" />
        </StackPanel>

        <!-- 结果区：这一页的主角，吃掉中间剩下的全部高度 -->
        <Grid Grid.Row="2" MinHeight="96" Margin="0,10,0,0">
            <TextBlock x:Name="ResultText" Text="—" FontSize="64" FontWeight="SemiBold"
                       FontFamily="Bahnschrift" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <!-- 提示与池子状态：贴在大字底下，小字退成配角 -->
            <TextBlock x:Name="HintText" FontSize="11.5" Opacity="0.6"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" IsHitTestVisible="False" Margin="0,6,0,0" />
        </Grid>

        <!-- 结果字号：与工具页「结果字号」滑块同一份存档字段（PickNumberConfig.NameScale），两边实时互通 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Center" Margin="0,8,0,0">
            <TextBlock Text="结果字号" FontSize="12" FontWeight="SemiBold"
                       VerticalAlignment="Center" Opacity="0.75" />
            <Slider x:Name="MiniScaleSlider" Width="120" Minimum="0.5" Maximum="3"
                    Value="1" VerticalAlignment="Center"
                    ValueChanged="MiniScale_Changed" />
            <TextBlock x:Name="MiniScaleText" Width="42" FontSize="12" Opacity="0.8"
                       TextAlignment="Right" VerticalAlignment="Center" Text="100%" />
        </StackPanel>

        <!-- 重置 + 抽取 + 不重复：同一行、居中 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Margin="0,8,0,0">
            <Button x:Name="ResetButton" Content="重置" Padding="26,7"
                    Click="Reset_Click"
                    ToolTip.Tip="清空已抽取的记录，重新开始" />
            <Button x:Name="DrawButton" Content="抽取" Theme="{StaticResource AccentButtonStyle}"
                    Padding="44,7" FontSize="15"
                    Click="Draw_Click" />
            <ToggleSwitch x:Name="NoRepeatBox" OnContent="不重复" OffContent="允许重复"
                          MinWidth="0" IsCheckedChanged="NoRepeat_Toggled" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
