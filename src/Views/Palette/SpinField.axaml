<UserControl
    x:Class="ClassSoftwareHub.Desktop.Views.Palette.SpinField"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      紧凑数字输入：**标签在上、窄框、右侧上下箭头**（Nick 2026-10-03 定的形态，照 AdaptiveTrigger 面板那种样式）。

      为什么不用原生 NumberBox：它数值放在 TextBox 里，触屏点一下会全选 + 弹"复制/粘贴"菜单，教室里很难受
      —— 这是 NumberStepper 当初自己写的原因（见 NumberStepper.axaml 注释）。所以这里沿用同一套做法：
      值用 TextBlock 显示，上下箭头是 RepeatButton（自带长按连发，按住不放就一直加）。

      宽度刻意做窄（默认 88），这样「范围 / 个数」两三个能并排放进一行。

      ⚠️ 移植说明（Win7）：
        · 原版的上下箭头是 `<primitives:RepeatButton>`（Microsoft.UI.Xaml.Controls.Primitives）——
          Avalonia 的 RepeatButton 就在默认命名空间（Avalonia.Controls），同名同签名，直接用，无需前缀。
        · 原版箭头字形靠 `FontFamily="Segoe Fluent Icons"`（Win10 自带）——
          Win7 没有该字体，改为内嵌图标字体资源 SymbolThemeFontFamily（见 App.axaml）。
          码位 &#xE70E; / &#xE70D; 一个字都没改。
    -->
    <StackPanel Spacing="4" VerticalAlignment="Top">

        <TextBlock x:Name="LabelText" FontSize="11.5" Opacity="0.65"
                   HorizontalAlignment="Center" TextWrapping="NoWrap" />

        <Border CornerRadius="4" BorderThickness="1"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Height="30" MinWidth="72">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ValueText" Text="0" FontSize="14" Margin="10,0,2,0"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- 上下箭头：叠在一个窄条里，上半下半分；右边留 3px，别把箭头怼在边框线上看着像截断 -->
                <Grid Grid.Column="1" Width="22" Height="26" Margin="0,1,3,1" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <RepeatButton x:Name="UpButton" Grid.Row="0" Content="&#xE70E;"
                                             FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="9"
                                             MinWidth="0" MinHeight="0" Padding="0"
                                             Delay="450" Interval="110"
                                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                             Background="Transparent" BorderThickness="0"
                                             AutomationProperties.Name="增加"
                                             Click="Up_Click" />
                    <RepeatButton x:Name="DownButton" Grid.Row="1" Content="&#xE70D;"
                                             FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="9"
                                             MinWidth="0" MinHeight="0" Padding="0"
                                             Delay="450" Interval="110"
                                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                             Background="Transparent" BorderThickness="0"
                                             AutomationProperties.Name="减少"
                                             Click="Down_Click" />
                </Grid>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
