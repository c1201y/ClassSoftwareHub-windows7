<platform:PageBase
    x:Class="ClassSoftwareHub.Desktop.Pages.ExperimentalPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platform="using:ClassSoftwareHub.Desktop.Platform"
    xmlns:fa="using:FluentAvalonia.UI.Controls"
    xmlns:data="using:ClassSoftwareHub.Desktop.Data">

    <!--
      和首页 / 设置页 / 内置工具页同一套版式：ScrollViewer 在最外层（滚动条贴窗口最右），
      内容钉在中间 960 宽。

      ✅ 2026-10-18 自上游 1.2.0 移植：卡片整段改成**照搬首页「快速开始」那套**（Nick：「直接复用首页卡片」）：
         · 外观 = cshNavCard（圆角 8 / Padding 14,18），标题 14 不加粗、
           说明 12 / Opacity 0.78、右端 E8A7 指示符 —— 与首页逐项一致；
         · 板式 = 左右两个 ItemsControl 各占一列（首页也是手写两列），
           卡片宽度天然跟着列宽走 ⇒ 窗口再窄也是两列，不会掉成单列、右边留一大片空。
         ⛔ 前一版试过「WrapPanel + 固定卡宽」，窄窗口下不可靠（掉成单列），已弃用。
    -->
    <platform:PageBase.Resources>
        <!-- 首页「快速开始」那张卡：左右两列共用同一个模板 -->
        <DataTemplate x:Key="NavCardTemplate">
            <Border Classes="cshNavCard"
                    PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                    Tapped="Card_Tapped">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <fa:FontIcon Glyph="{Binding Glyph}" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Desc}" FontSize="12" Opacity="0.78"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <fa:FontIcon Grid.Column="2" Margin="16,0,0,0" Glyph="&#xE8A7;" FontSize="12"
                                 VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </platform:PageBase.Resources>

    <ScrollViewer Padding="24,36,24,44" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
        <Grid MaxWidth="960" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="实验性功能" FontSize="30" FontWeight="Bold" />
                <TextBlock FontSize="12.5" Opacity="0.65" TextWrapping="Wrap"
                           Text="暂未达到主界面功能可靠程度的试验性功能集中于此。功能可用，但结果不保证准确，界面后续仍可能调整。" />
            </StackPanel>

            <!-- 两列（首页「快速开始」同款：列间距 8、行间距 8）：
                 序号偶数的进左列、奇数的进右列，见 code-behind。 -->
            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ItemsControl x:Name="CardColumnLeft" Grid.Column="0"
                              ItemTemplate="{StaticResource NavCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ItemsControl x:Name="CardColumnRight" Grid.Column="1" Margin="8,0,0,0"
                              ItemTemplate="{StaticResource NavCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>

            <!-- 页脚：把「实验性」这个标签的含义和检测范围讲清楚（先说清边界，别让用户自己猜） -->
            <Border Grid.Row="2" CornerRadius="4" Padding="20,16" Margin="0,20,0,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <!-- 原 ColumnSpacing=16 / RowSpacing=6 → 列 1 加 16 左 Margin；行 1/2 各加 6/10 顶 Margin
                     （行 2 原本还带 Margin="0,4,0,0"，6+4=10） -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <fa:FontIcon Glyph="&#xEA80;" FontSize="20" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Margin="16,0,0,0" Text="「实验性」的含义" FontSize="15" FontWeight="Bold" />

                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="16,6,0,0" FontSize="12.5" Opacity="0.7"
                               TextWrapping="Wrap"
                               Text="以下功能处于成型阶段，因此入口保留在此处而非主界面：功能成熟后逐步移入主界面。列于此处表示功能已可试用，不代表其可靠程度已达到正式功能水平。" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="16,10,0,0" FontSize="12" Opacity="0.6"
                               TextWrapping="Wrap"
                               Text="使用中如确认功能可用，或发现判断有误，均可在「反馈中心」提交反馈。此类功能的去留取决于实际使用反馈。" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</platform:PageBase>
