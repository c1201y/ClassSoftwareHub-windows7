<platform:PageBase
    x:Class="ClassSoftwareHub.Desktop.Pages.LogViewerPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platform="using:ClassSoftwareHub.Desktop.Platform"
    xmlns:fa="using:FluentAvalonia.UI.Controls"
    xmlns:ctl="using:ClassSoftwareHub.Desktop.Controls"
    Background="{x:Null}">

    <!--
      日志查看（自上游 dv1.1.3 移植：工具栏并进标题行 + 多选芯片独占一行）。

      骨架只有 4 行，**不套卡片** —— 原来「工具条 + 一整张大卡片（筛选/列头/表格/状态行
      全关在里面）」那种写法，光是内边距和两行工具栏就吃掉大半个屏，正文只剩一小条。

        0 标题行：左「日志」+ 会话 / 文件 / 搜索，右 = 动作按钮组（详细视图 + 4 个图标钮）
        1 芯片行：**只有**那排级别芯片 —— 独占一行才摆得开
        2 表格  ：唯一一个 `*` 行 —— 页面剩下的高度全给它
        3 统计行：一条把"这次运行到底有多少东西"讲清楚的动态统计

      ⚠️⚠️ **窄窗口不许吞控件**：第 0 行左边那条（标题 + 两个下拉 + 搜索）与第 1 行整条，
        都放进**横向滚动容器**里。被挤的时候表现是"这条能横向滚过去"，而不是控件被裁掉、
        点都点不着。右侧动作钮所在的列是 Auto，永远完整可见 —— ⛔ 反过来写就会先吞按钮。

      其它约束：
        · 本页不套 ScrollViewer —— 表格自己滚；
        · 级别颜色不能写在行模板的 XAML 里（SystemFillColor* 按项取不到，§D-3），
          统一走 ctl:LogLevelBrushConverter 在代码里查表；
        · 级别筛选用「计数芯片」（Controls/LevelChipBar）：**多选**，⛔ 不用 SelectorBar / Pivot；
        · ⛔ 没有"自动刷新"开关了：只在"停在末尾"时静默跟随。

      ⚠️ 移植说明（WinUI → Avalonia/FluentAvalonia）：
        · 根元素 Page → platform:PageBase；原版 NavigationCacheMode="Enabled" 由 ShellPage 的
          <fa:Frame CacheSize="0"/> 统一承担（本页不缓存，切走即丢弃，等价于原版 OnNavigatingFrom 里停表）。
        · 版式：原版「外列 24/*/24 + 内层 Grid MaxWidth=960」→ 本仓库统一的三列版式
          `1* / 998* MaxWidth=960 / 1*`（与设置页/软件下载页同一套，内容钉在中间 960 宽）。
          ⚠️ 不要给内层 Grid 写 HorizontalAlignment="Center"：Avalonia 里 Center 会「缩成内容宽再居中」，
             空状态下整页会挤在屏幕中间一条窄带里。
        · Grid 无 RowSpacing/ColumnSpacing → 用子元素 Margin 模拟（间距值照搬原版）。
        · Grid 无 Padding → Margin 合并（如列头 Padding="0,8" → Margin="12,8"）。
        · Visibility="Collapsed" → IsVisible="False"。
        · ThemeResource → DynamicResource；x:Bind → {Binding}。
        · ListView → ListBox（Extended → Multiple）；ListView.ContextFlyout → ListBox.ContextFlyout。
        · MenuFlyoutItem → MenuItem（Header 而非 Text）；MenuFlyoutSeparator → Separator。
        · AutoSuggestBox（Avalonia 无对应控件）→ TextBox + 左侧叠加放大镜 FontIcon（与软件下载页同一手法）。
        · TextBlock.IsTextSelectionEnabled → SelectableTextBlock。
        · ToolTipService.ToolTip → ToolTip.Tip。
        · ScrollViewer 无 HorizontalScrollMode/VerticalScrollMode（Avalonia 只有条可见性）→ 去掉这两个属性。
        · Style TargetType="Button" + x:Key → Style Selector="Button" + x:Key。
        · 原版 CaptionTextBlockStyle（WinUI 样式键，FA 里没有）→ 内联 FontSize="12"。
        · ContainerContentChanging（Avalonia 无容器复用事件）→ 行模板里绑 ctl:LogLevelBrushConverter。
    -->

    <platform:PageBase.Resources>
        <!-- 级别 → 主题画刷（替代原版 ContainerContentChanging 里按项查表赋值） -->
        <ctl:LogLevelBrushConverter x:Key="LevelBrush" />

        <DataTemplate x:Key="LogRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 时间：等宽且纯 ASCII（不触发字体回退），各列才能对齐 -->
                <TextBlock Text="{Binding Time}" FontSize="12" FontFamily="Consolas"
                           VerticalAlignment="Top" Margin="0,2,8,0" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Stamp}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"
                            VerticalAlignment="Top" Margin="0,1,0,0">
                    <fa:FontIcon Glyph="{Binding LevelGlyph}" FontSize="12"
                                 Foreground="{Binding Level, Converter={StaticResource LevelBrush}}" />
                    <TextBlock Text="{Binding LevelText}" FontSize="12"
                               Foreground="{Binding Level, Converter={StaticResource LevelBrush}}" />
                </StackPanel>

                <!-- 模块：行内标签，单独一列，方便一眼看出是谁写的 -->
                <TextBlock Grid.Column="2" Text="{Binding ModuleText}" FontSize="12" FontFamily="Consolas"
                           VerticalAlignment="Top" Margin="0,2,8,0" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Module}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <!-- 内容用系统 UI 字体：日志以中文为主，Consolas 没有汉字会触发字体回退，字重字距都会错位 -->
                <SelectableTextBlock Grid.Column="3" Text="{Binding Message}" FontSize="13"
                                     TextWrapping="Wrap"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Grid>
        </DataTemplate>

        <!-- 动作图标钮：一行 5 个也要压得住，所以统一 32×32、无内边距以外的装饰。
             ⚠️ 移植：原版是 Style x:Key + TargetType="Button"，Avalonia 的控件没有可赋值的
                Style 属性（只有 Styles 集合），所以改成 Button.iconAction 的 Class 选择器。 -->
    </platform:PageBase.Resources>

    <!-- 日志行容器：原版 ListView.ItemContainerStyle → Avalonia 的 Style 叠加在 ListBoxItem 上
         （只设属性、不换模板，容器的悬停/选中反馈照旧）。
         左边距必须跟上面列头的 Margin 一致，否则表头和内容会错开。 -->
    <platform:PageBase.Styles>
        <!-- 动作图标钮（原版 Style x:Key="IconActionStyle" TargetType="Button"） -->
        <Style Selector="Button.iconAction">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="ListBox#LogList ListBoxItem">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </platform:PageBase.Styles>

    <!-- 三列钉宽版式（原版 24/*/24 + 内层 MaxWidth=960 的等价写法） -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="998*" MaxWidth="960" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- 原版 RowSpacing="10" → 第 1~3 行各加 Margin="0,10,0,0" -->
        <Grid Grid.Column="1" Margin="0,32,0,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- 0 标题 + 会话/文件/搜索 + 动作 -->
                <RowDefinition Height="Auto" />  <!-- 1 级别芯片（独占一行） -->
                <RowDefinition Height="*" />     <!-- 2 表格（占满剩余高度） -->
                <RowDefinition Height="Auto" />  <!-- 3 统计行 -->
            </Grid.RowDefinitions>

            <!-- ===== 0 标题 + 选择 + 搜索 + 动作 ===== -->
            <!-- 原版 ColumnSpacing="12" → 第 1 列加 12 左 Margin -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左条：横向可滚（窄窗口兜底，见文件头注释） -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="日志" FontSize="28" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,4,0" />

                        <!-- 一级：哪一次运行 -->
                        <ComboBox x:Name="SessionBox" MinWidth="140" MaxWidth="176"
                                  VerticalAlignment="Center"
                                  SelectionChanged="SessionBox_SelectionChanged" />

                        <!-- 二级：该次运行里的哪个文件（app.log / crash.log） -->
                        <ComboBox x:Name="FileBox" MinWidth="102" MaxWidth="142"
                                  VerticalAlignment="Center"
                                  SelectionChanged="FileBox_SelectionChanged" />

                        <!-- 原版 AutoSuggestBox（含 QueryIcon="Find"）在 Avalonia 里没有对应控件 →
                             改用 TextBox + 左侧叠加一枚放大镜 FontIcon（视觉等价），事件仍是 TextChanged。 -->
                        <Grid Width="176" VerticalAlignment="Center">
                            <TextBox x:Name="FilterBox" Watermark="筛选日志…"
                                     Padding="34,0,12,0" VerticalContentAlignment="Center"
                                     TextChanged="FilterBox_TextChanged" />
                            <fa:FontIcon Glyph="&#xE721;" FontSize="14" Margin="12,0,0,0"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Opacity="0.6" IsHitTestVisible="False" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center">
                    <Button x:Name="DetailButton" Click="Detail_Click"
                            Padding="10,5,12,5" Margin="0,0,6,0"
                            ToolTip.Tip="在独立窗口里打开详细视图：全量行、毫秒时间、序号、原始堆栈">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <fa:FontIcon Glyph="&#xE8A7;" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="详细视图" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Classes="iconAction" Click="Refresh_Click"
                            ToolTip.Tip="重新读取当前文件">
                        <fa:FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>

                    <Button Classes="iconAction" Click="Export_Click"
                            ToolTip.Tip="把本机全部会话日志打成一个压缩包（交给开发者最省事的一步）">
                        <fa:FontIcon Glyph="&#xE896;" FontSize="14" />
                    </Button>

                    <Button Classes="iconAction" Click="OpenFolder_Click"
                            ToolTip.Tip="打开日志根目录，每个子文件夹就是一次运行">
                        <fa:FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    </Button>

                    <Button Classes="iconAction" Click="FilesHelp_Click"
                            ToolTip.Tip="这些日志文件分别是干什么的">
                        <fa:FontIcon Glyph="&#xE946;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== 1 级别芯片 =====
                 多选，无「全部」（全勾即全部）。
                 整条横向可滚：窗口拉窄时是"能滚过去"，⛔ 不是芯片被裁掉。 -->
            <ScrollViewer Grid.Row="1" Margin="0,10,0,0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ChipHost" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center" />
            </ScrollViewer>

            <!-- ===== 2 表格 =====
                 这里不放卡片、不放内边距：就是一条细边框 + 列头 + 列表。
                 ⛔ 列宽必须跟上面 LogRowTemplate 一模一样。 -->
            <Border Grid.Row="2" Margin="0,10,0,0" CornerRadius="4" BorderThickness="1"
                    Background="Transparent"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />  <!-- 列头 -->
                        <RowDefinition Height="Auto" />  <!-- 分隔线 -->
                        <RowDefinition Height="*" />     <!-- 日志 -->
                    </Grid.RowDefinitions>

                    <!-- 原版 Grid Margin="12,0" Padding="0,8"（Avalonia Grid 无 Padding）→ Margin="12,8" -->
                    <Grid Grid.Row="0" Margin="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="时间" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="级别" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="模块" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="内容" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource CardStrokeColorDefaultBrush}" />

                    <!-- 空表提示：白色表格最让人发懵（是没内容？还是被我筛没了？），
                         所以"为什么空"必须写出来。文案在 UpdateEmptyHint 里拼。 -->
                    <TextBlock Grid.Row="2" x:Name="EmptyHint" IsVisible="False"
                               Margin="14,22,14,14" TextWrapping="Wrap"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <!--
                      复制动作走右键菜单 + Ctrl+C，**不再占工具条**。
                      右键菜单同时也是"去详细视图"的第二条入口。
                    -->
                    <ListBox Grid.Row="2" x:Name="LogList" SelectionMode="Multiple"
                             Background="Transparent"
                             ItemTemplate="{StaticResource LogRowTemplate}"
                             KeyDown="LogList_KeyDown">
                        <ListBox.ContextFlyout>
                            <MenuFlyout>
                                <MenuItem Header="复制选中行" Click="CopySelected_Click" />
                                <MenuItem Header="复制筛选结果" Click="CopyFiltered_Click" />
                                <Separator />
                                <MenuItem Header="在详细视图中打开" Click="Detail_Click" />
                            </MenuFlyout>
                        </ListBox.ContextFlyout>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ===== 3 统计行 =====
                 开发者一眼要看的东西：这次运行有多少条、分布在哪些模块、跨多长时间、
                 文件多大、这份是不是被截断过的。模块分布全量挂在 ToolTip 上。 -->
            <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        </Grid>
    </Grid>
</platform:PageBase>
