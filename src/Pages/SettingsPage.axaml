<platform:PageBase
    x:Class="ClassSoftwareHub.Desktop.Pages.SettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platform="using:ClassSoftwareHub.Desktop.Platform"
    xmlns:fa="using:FluentAvalonia.UI.Controls"
    xmlns:core="using:ClassSoftwareHub.Desktop.Core"
    xmlns:views="using:ClassSoftwareHub.Desktop.Views"
    xmlns:controls="using:ClassSoftwareHub.Desktop.Controls">

    <!--
      ⚠️ 移植说明（WinUI → Avalonia/FluentAvalonia）：
        · 原版 Page 根元素上的 NavigationCacheMode="Disabled" —— Avalonia 侧由
          ShellPage 的 <fa:Frame CacheSize="0"/> 统一承担（页面不留在内存里），这里不再单设。
        · CommunityToolkit 的 SettingsCard → 本工程自建 views:SettingsCard（FA 没有，
          见 Views/SettingsCard.axaml）；SettingsExpander → fa:SettingsExpander
          （⚠️ 图标属性叫 IconSource，不叫 HeaderIcon）。
        · ThemeResource → DynamicResource；GridView + ItemsWrapGrid + ItemTemplateSelector →
          ItemsControl + WrapPanel + IDataTemplate（QuickLinkSelector 已是 IDataTemplate）。

      设置页版式遵循 WinUI 3 / WinUI Gallery 的设置页规范（2026-09-28 重构）：
        · 整页背景透明 —— 窗口的 Mica / 亚克力 / Win7 毛玻璃从 MainWindow 的 Backdrop 透上来，
          不允许再出现纯黑、纯灰的实心底色（旧版是一整块自绘 Border，把材质全盖死了）。
        · 每一项 = 一张 SettingsCard：左侧 HeaderIcon + Header（BodyStrong）+ Description（Caption
          + TextFillColorSecondary，由卡片模板自动套），右侧放开关 / 下拉 / 按钮。
          卡片自带 16px 内边距，右侧控件与卡片右边缘的间距天然统一，不要自己再加外边距。
        · 同一组内的卡片间距 4px（StackPanel Spacing），组标题距上一组 24px。
        · 折叠区用 SettingsExpander，外观与 SettingsCard 一致，不再混用原生 Expander（圆角/描边不一样）。
      ⚠️ 卡片模板对 Header / Description 的字体样式是写死在控件模板里的，别再手工指定，
         否则会和工具栏那套 TextBlock 样式打架。
    -->

    <platform:PageBase.Resources>
        <!-- 快捷入口两套模板（同首页）：颜色全走 {DynamicResource}，浅色/深色自己会变 -->
        <DataTemplate x:Key="QuickLinkNormal">
            <!-- ⚠️ Background="Transparent" 必须有：Avalonia 里没 Background 的 Border **不参与命中测试**，
                 点卡片空白处（图标文字之外）事件直接穿透 —— 看起来就是"这些按钮只有赞助作者能点"
                 （2026-10-03 实机反馈）。Transparent 既能命中又看不见。 -->
            <Border CornerRadius="4" Padding="12,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="Transparent">
                <StackPanel Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <fa:FontIcon Glyph="{Binding Glyph}" FontSize="24" HorizontalAlignment="Center"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.95" />
                    <TextBlock Text="{Binding Name}" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="QuickLinkAccent">
            <Border CornerRadius="4" Padding="12,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                <StackPanel Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <fa:FontIcon Glyph="{Binding Glyph}" FontSize="24" HorizontalAlignment="Center"
                              Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Opacity="0.95" />
                    <TextBlock Text="{Binding Name}" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <core:QuickLinkSelector x:Key="QuickLinkSelector"
                                Normal="{StaticResource QuickLinkNormal}"
                                Accent="{StaticResource QuickLinkAccent}" />
    </platform:PageBase.Resources>

    <!-- ⛔ 不写 Background：App.axaml 给全站 ScrollViewer 设了 Transparent（见那里的注释）——
         写 `{x:Null}` 会盖掉它，标题上方的缝隙又会滚不动。 -->
    <!-- ⚠️ 移植说明：原版本轮把间距从 ScrollViewer.Padding 改到内部 Grid 的 Margin
         （WinUI 3 的 ScrollViewer.Padding 底部不参与滚动范围计算，滚到底最后一条内容仍被裁）。
         Avalonia 侧一并照搬：三列 24/*/24 + StackPanel MaxWidth=960 居中（同首页版式）。 -->
    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto">
        <!-- 和首页同一套版式：三列 Grid 把内容钉在中间 960 宽，导航展开/收起都不动 -->
        <Grid Margin="24,36,24,44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" MaxWidth="960">

                <TextBlock Text="设置" FontSize="28" FontWeight="Bold" />

                <!-- ===== 关于（最上，不要卡片底，自成一块区域） ===== -->
                <StackPanel Spacing="4" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Image x:Name="AboutIcon" Width="44" Height="44" VerticalAlignment="Center" />
                        <TextBlock x:Name="AboutApp" Text="ClassSoftwareHub" FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="AboutVersion" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="AboutSiteVersion" FontSize="12" Opacity="0.75" />
                </StackPanel>

                <!-- 相关链接（在版本号下面，跟首页那行同款）
                     ⚠️ 移植说明：原版 GridView + ItemsWrapGrid(ItemWidth 192 / ItemHeight 88) +
                     ItemTemplateSelector。Avalonia 用 ItemsControl + WrapPanel（ItemWidth/ItemHeight
                     同值）还原；GridView 的 IsItemClickEnabled + ItemClick → Tapped 冒泡（点在
                     卡片上冒到 ItemsControl，code-behind 从 DataContext 取 QuickLink）。 -->
                <ItemsControl x:Name="SettingsQuickGrid" Margin="0,6,0,0"
                              ItemTemplate="{StaticResource QuickLinkSelector}"
                              Tapped="Quick_ItemClick">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="192" ItemHeight="88" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- 法律条款（与网页端设置页「关于」区一致：用户协议 / 隐私政策 / 免责声明） -->
                <TextBlock Text="法律条款" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,8" />
                <StackPanel Spacing="4">
                    <views:SettingsCard Header="用户协议" IsClickEnabled="True" Click="OpenLegal_Click" Tag="agreement">
                        <views:SettingsCard.HeaderIcon>
                            <fa:FontIcon Glyph="&#xE9D5;" />
                        </views:SettingsCard.HeaderIcon>
                    </views:SettingsCard>
                    <views:SettingsCard Header="隐私政策" IsClickEnabled="True" Click="OpenLegal_Click" Tag="privacy">
                        <views:SettingsCard.HeaderIcon>
                            <fa:FontIcon Glyph="&#xE8C8;" />
                        </views:SettingsCard.HeaderIcon>
                    </views:SettingsCard>
                    <views:SettingsCard Header="免责声明" IsClickEnabled="True" Click="OpenLegal_Click" Tag="disclaimer">
                        <views:SettingsCard.HeaderIcon>
                            <fa:FontIcon Glyph="&#xEA18;" />
                        </views:SettingsCard.HeaderIcon>
                    </views:SettingsCard>
                </StackPanel>

                <!-- ================= 外观 ================= -->
                <!-- 本文件原用 BodyStrongTextBlockStyle / CaptionTextBlockStyle（WinUI 样式键，FA 里没有）→ 已内联为 FontSize/FontWeight -->
                <TextBlock Text="外观" FontSize="14" FontWeight="SemiBold" Margin="0,24,0,8" />
                <StackPanel Spacing="4">

                    <views:SettingsCard Header="颜色模式" Description="跟随系统时，随 Windows 的深浅色设置自动切换。">
                        <views:SettingsCard.HeaderIcon>
                            <fa:FontIcon Glyph="&#xE790;" />
                        </views:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ThemeCombo" MinWidth="170" SelectionChanged="ThemeChoice_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" Tag="system" />
                            <ComboBoxItem Content="浅色" Tag="light" />
                            <ComboBoxItem Content="深色" Tag="dark" />
                        </ComboBox>
                    </views:SettingsCard>

                    <views:SettingsCard Header="外部组件单独设置外观"
                                           Description="外部组件指屏幕侧边栏、常用工具浮窗与截图编辑窗；主界面不受影响。">
                        <views:SettingsCard.HeaderIcon>
                            <fa:FontIcon Glyph="&#xE772;" />
                        </views:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="SplitThemeSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                      IsCheckedChanged="SplitTheme_Toggled" />
                    </views:SettingsCard>

                    <views:SettingsCard Header="外部组件外观">
                        <views:SettingsCard.HeaderIcon>
                            <fa:FontIcon Glyph="&#xE772;" />
                        </views:SettingsCard.HeaderIcon>
                        <views:SettingsCard.Description>
                            <TextBlock x:Name="ExtThemeHint" TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </views:SettingsCard.Description>
                        <ComboBox x:Name="ExtThemeCombo" MinWidth="170" SelectionChanged="ExtTheme_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" Tag="system" />
                            <ComboBoxItem Content="浅色" Tag="light" />
                            <ComboBoxItem Content="深色" Tag="dark" />
                        </ComboBox>
                    </views:SettingsCard>

                    <views:SettingsCard Header="窗口背景效果"
                                           Description="主界面、常用工具浮窗与截图编辑窗都随此项；截图框选层与钉图不参与。">
                        <views:SettingsCard.HeaderIcon>
                            <fa:FontIcon Glyph="&#xE81E;" />
                        </views:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="BackdropCombo" MinWidth="170" SelectionChanged="BackdropChoice_SelectionChanged">
                            <ComboBoxItem Content="亚克力（半透明）" Tag="acrylic" />
                            <ComboBoxItem Content="云母（更接近系统窗口）" Tag="mica" />
                            <ComboBoxItem Content="纯色（最省性能）" Tag="solid" />
                        </ComboBox>
                    </views:SettingsCard>

                </StackPanel>

                <!-- ================= 窗口 ================= -->
                <TextBlock Text="窗口" FontSize="14" FontWeight="SemiBold" Margin="0,24,0,8" />
                <StackPanel Spacing="4">

                    <views:SettingsCard Header="窗口始终置于最前"
                                           Description="开启后主窗口不会被其他窗口遮挡。">
                        <views:SettingsCard.HeaderIcon>
                            <fa:FontIcon Glyph="&#xE718;" />
                        </views:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="TopMostSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                      IsCheckedChanged="TopMostSwitch_Toggled" />
                    </views:SettingsCard>

                    <views:SettingsCard Header="开机自动启动"
                                           Description="登录 Windows 后自动运行本程序。">
                        <views:SettingsCard.HeaderIcon>
                            <fa:FontIcon Glyph="&#xE7E8;" />
                        </views:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="AutoStartSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                      IsCheckedChanged="AutoStartSwitch_Toggled" />
                    </views:SettingsCard>

                    <views:SettingsCard Header="开机时最小化启动">
                        <views:SettingsCard.HeaderIcon>
                            <fa:FontIcon Glyph="&#xE921;" />
                        </views:SettingsCard.HeaderIcon>
                        <views:SettingsCard.Description>
                            <TextBlock x:Name="MinimizeHint" TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </views:SettingsCard.Description>
                        <ToggleSwitch x:Name="MinimizeSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                      IsCheckedChanged="MinimizeSwitch_Toggled" />
                    </views:SettingsCard>

                    <views:SettingsCard Header="点关闭时收进托盘"
                                           Description="关闭主窗口时程序继续在后台运行，从托盘图标可重新打开。">
                        <views:SettingsCard.HeaderIcon>
                            <fa:FontIcon Glyph="&#xE7E7;" />
                        </views:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="TraySwitch" OnContent="开" OffContent="关" MinWidth="0"
                                      IsCheckedChanged="TraySwitch_Toggled" />
                    </views:SettingsCard>

                </StackPanel>

                <!-- ================= 常用工具 / 截图 ================= -->
                <!-- 2026-10-07（对齐上游 dv1.1.0）：原「常用工具」整组（浮窗置顶 / 屏幕边缘侧边栏 /
                     放置模式 / 贴哪条边）与「截图」两项，上游 2026-10-01 都搬去了「侧边布局」页 ——
                     那页本就是侧边栏与常用工具的布置中心。这里整块删干净，别再往设置页加回来。 -->

                <!-- ================= 诊断 ================= -->
                <!-- 2026-10-02（原版）：日志查看从实验性分组挪来这儿（Nick：不是实验功能，设置里给个正式入口）。
                     位置他指定：窗口之后、软件内容之前。SettingsCard 整卡可点（IsClickEnabled）。
                     ⚠️ 右侧**不要**自己放箭头：IsClickEnabled=True 时卡片自带一颗 Chevron（2026-10-02 截到过两颗）。 -->
                <TextBlock Text="诊断" FontSize="14" FontWeight="SemiBold" Margin="0,24,0,8" />
                <StackPanel Spacing="4">

                    <views:SettingsCard Header="日志查看"
                                        Description="在应用内查看运行日志，可按级别与内容筛选，一键导出全部日志交给开发者。"
                                        IsClickEnabled="True" Click="OpenLogViewer_Click">
                        <views:SettingsCard.HeaderIcon>
                            <fa:FontIcon Glyph="&#xE7C3;" />
                        </views:SettingsCard.HeaderIcon>
                    </views:SettingsCard>

                </StackPanel>

                <!-- ================= 软件内容 ================= -->
                <TextBlock Text="软件内容" FontSize="14" FontWeight="SemiBold" Margin="0,24,0,8" />
                <StackPanel Spacing="4">

                    <views:SettingsCard Header="本地内容包">
                        <views:SettingsCard.HeaderIcon>
                            <fa:FontIcon Glyph="&#xE8B7;" />
                        </views:SettingsCard.HeaderIcon>
                        <views:SettingsCard.Description>
                            <StackPanel Spacing="6" Margin="0,4,0,0">
                                <TextBlock Text="软件清单与分类来自内容包；重新读取会用当前本地数据再解析一遍。"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ContentSummary" TextWrapping="Wrap" Margin="0,4,0,0"
                                           FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="ContentSource" TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ContentIssues" TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button Content="重新读取内容" Click="ReloadContent_Click" />
                                    <Button Content="同步内容包" Click="SyncContent_Click" />
                                    <Button Content="打开内容目录" Click="OpenContentDir_Click" />
                                </StackPanel>
                            </StackPanel>
                        </views:SettingsCard.Description>
                    </views:SettingsCard>

                    <views:SettingsCard Header="GitHub 应用更新加速源">
                        <views:SettingsCard.HeaderIcon>
                            <fa:FontIcon Glyph="&#xE8A1;" />
                        </views:SettingsCard.HeaderIcon>
                        <views:SettingsCard.Description>
                            <StackPanel Spacing="6" Margin="0,4,0,0">
                                <TextBlock Text="指定更新包等自动下载时 GitHub 链接的取用路径。详情页的「下载」始终直连 GitHub 官方；「加速下载」自动选择——自建节点优先，不可用时测速挑选最快的公益镜像。官网直链、网盘等非 GitHub 来源不受影响。"
                                           TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="GithubRouteHint" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </views:SettingsCard.Description>
                        <ComboBox x:Name="GithubRouteCombo" MinWidth="240" SelectionChanged="GithubRoute_SelectionChanged">
                            <ComboBoxItem Tag="auto"><TextBlock Text="自动" /></ComboBoxItem>
                            <ComboBoxItem Tag="selfhosted"><TextBlock Text="自建加速服务" /></ComboBoxItem>
                            <ComboBoxItem Tag="github"><TextBlock Text="GitHub 源" /></ComboBoxItem>
                        </ComboBox>
                    </views:SettingsCard>

                    <fa:InfoBar x:Name="GithubRouteWarning" Severity="Informational" IsClosable="False" IsOpen="False"
                                Title="自建加速已启用" Message="更新包等自动下载优先走社区自建节点（本站 Worker 代签、限时直链）；节点不可用时自动测速挑选最快的公益镜像，仍不可用再回 GitHub 源。"
                                Margin="0,8,0,0" />

                </StackPanel>

                <!-- ================= 回声洞 ================= -->
                <!-- 2026-10-03（原版）三次改版：**单独一块、单独一个「回声洞」标题**（不并进「软件内容」）；
                     形态对齐 ClassIsland 的「关于 → 回声洞」：一个 SettingsExpander，
                     展开区里**只有一张卡片**，里面**只有字条本身**（Controls/EchoCaveCard，
                     标准正文字号、自己不带边框、不写任何状态文字）；
                     「投稿」按钮在卡片右侧，点开是个 Flyout：一个输入框 + 一个提交按钮，不跳浏览器；回执也留在这个弹层里。 -->
                <TextBlock Text="回声洞" FontSize="14" FontWeight="SemiBold" Margin="0,24,0,8" />
                <StackPanel Spacing="4">

                    <fa:SettingsExpander x:Name="EchoCaveExpander" Header="回声洞"
                                         Description="请点击这里收看 ClassSoftwareHub 群友的逆天发言！"
                                         IsExpanded="False">
                        <fa:SettingsExpander.IconSource>
                            <fa:FontIconSource FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xE8BD;" />
                        </fa:SettingsExpander.IconSource>
                        <fa:SettingsExpander.Items>

                            <!-- 展开区唯一的一张卡片：整卡可点＝换一条（悬停底色铺满整行，正文自己不带框）；右边一颗「投稿」 -->
                            <views:SettingsCard IsClickEnabled="True" Click="EchoCave_Click"
                                                IsActionIconVisible="False"
                                                ToolTip.Tip="点击换一条">
                                <views:SettingsCard.Header>
                                    <controls:EchoCaveCard x:Name="EchoCave" />
                                </views:SettingsCard.Header>
                                <Button Content="投稿" VerticalAlignment="Center">
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                            <StackPanel Width="320" Spacing="10">
                                                <TextBlock Text="投稿到回声洞" FontSize="14" FontWeight="SemiBold" />
                                                <TextBox x:Name="EchoSubmitBox"
                                                         Watermark="写一句让人笑出声的话"
                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                         MinHeight="76" MaxLength="200" />
                                                <TextBlock x:Name="EchoSubmitStatus" TextWrapping="Wrap"
                                                           IsVisible="False" FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Button x:Name="EchoSubmitFallback"
                                                        Content="改用 GitHub 网页投稿"
                                                        Padding="0" MinWidth="0" IsVisible="False"
                                                        Click="SubmitEchoCaveFallback_Click" />
                                                <Button x:Name="EchoSubmitButton" Content="提交"
                                                        HorizontalAlignment="Right"
                                                        Classes="accent"
                                                        Click="SubmitEchoCave_Click" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </views:SettingsCard>

                        </fa:SettingsExpander.Items>
                    </fa:SettingsExpander>

                </StackPanel>

                <!-- ================= 更新 ================= -->
                <TextBlock Text="更新" FontSize="14" FontWeight="SemiBold" Margin="0,24,0,8" />
                <StackPanel Spacing="4">

                    <views:SettingsCard Header="当前版本">
                        <views:SettingsCard.HeaderIcon>
                            <fa:FontIcon Glyph="&#xE896;" />
                        </views:SettingsCard.HeaderIcon>
                        <views:SettingsCard.Description>
                            <TextBlock x:Name="UpdateCurrent" TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </views:SettingsCard.Description>
                    </views:SettingsCard>

                    <views:SettingsCard Header="更新通道"
                                           Description="稳定通道更稳；Insider 通道能更早拿到新功能。">
                        <views:SettingsCard.HeaderIcon>
                            <fa:FontIcon Glyph="&#xE895;" />
                        </views:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ChannelCombo" MinWidth="170" SelectionChanged="ChannelChoice_SelectionChanged">
                            <ComboBoxItem Content="稳定通道" Tag="stable" />
                            <ComboBoxItem Content="Insider 通道" Tag="insider" />
                        </ComboBox>
                    </views:SettingsCard>

                    <views:SettingsCard Header="启动时自动检查更新"
                                           Description="仅检查，不自动安装。">
                        <views:SettingsCard.HeaderIcon>
                            <fa:FontIcon Glyph="&#xE72C;" />
                        </views:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="AutoCheckSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                      IsCheckedChanged="AutoCheckSwitch_Toggled" />
                    </views:SettingsCard>

                    <views:SettingsCard Header="检查更新"
                                           Description="发现新版本会先询问是否安装，不会自动更新；最小化启动时会通过系统通知提醒。">
                        <views:SettingsCard.HeaderIcon>
                            <fa:FontIcon Glyph="&#xE896;" />
                        </views:SettingsCard.HeaderIcon>
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- ⚠️ 移植说明：原版 Style="{ThemeResource AccentButtonStyle}" —— FA 的
                                     程序集里没这个键，改用 FA 自带的 accent 伪类（同 MainWindow 的用法）。 -->
                                <Button x:Name="CheckButton" Content="检查更新" Click="CheckUpdate_Click"
                                        Classes="accent" />
                            </StackPanel>
                            <ProgressBar x:Name="UpdateProgress" IsVisible="False" />
                            <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="UpdateNotes" TextWrapping="Wrap" MaxLines="8" IsVisible="False"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </views:SettingsCard>

                    <!-- 安装包自动清理：updates 目录只留最近 N 个，更早的启动时删除（InstallerCleanup）。
                         留下的包给「版本记录 → 装回旧版本」用：本地有同名包且校验通过就不再下载。 -->
                    <views:SettingsCard Header="安装包保留数量"
                                           Description="自动清理更新时下载的安装包：本地保留最近几个，更早的自动删除。保留的安装包可用于装回旧版本，无需重新下载。">
                        <views:SettingsCard.HeaderIcon>
                            <fa:FontIcon Glyph="&#xE74D;" />
                        </views:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="KeepCombo" MinWidth="170" SelectionChanged="KeepCombo_SelectionChanged">
                            <ComboBoxItem Content="1 个" Tag="1" />
                            <ComboBoxItem Content="2 个" Tag="2" />
                            <ComboBoxItem Content="3 个" Tag="3" />
                            <ComboBoxItem Content="4 个" Tag="4" />
                            <ComboBoxItem Content="5 个" Tag="5" />
                            <ComboBoxItem Content="6 个" Tag="6" />
                            <ComboBoxItem Content="7 个" Tag="7" />
                            <ComboBoxItem Content="8 个" Tag="8" />
                            <ComboBoxItem Content="9 个" Tag="9" />
                            <ComboBoxItem Content="10 个" Tag="10" />
                        </ComboBox>
                    </views:SettingsCard>

                    <!-- 本地安装包：列表在展开时现读（平时折叠，不占加载时间）。
                         ⚠️ 内容走 Items / Description —— ContentAlignment="Vertical" 实测无效（§K.6）
                         ⚠️ 移植说明：原版 Toolkit 的 Expanded 事件 FA 没有 → code-behind 里监听 IsExpandedProperty。 -->
                    <fa:SettingsExpander x:Name="InstallerExpander" Header="本地安装包"
                                               Description="更新时下载的安装包存放在此，可直接用来覆盖安装当前（或更旧）版本，也可单独删除。"
                                               IsExpanded="False">
                        <fa:SettingsExpander.IconSource>
                            <fa:FontIconSource FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xE8B7;" />
                        </fa:SettingsExpander.IconSource>
                        <fa:SettingsExpander.Items>
                            <views:SettingsCard Header="已下载的安装包">
                                <views:SettingsCard.Description>
                                    <StackPanel Spacing="6" Margin="0,4,0,0">
                                        <TextBlock x:Name="InstallerDirText" TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <StackPanel x:Name="InstallerList" Spacing="6" />
                                    </StackPanel>
                                </views:SettingsCard.Description>
                            </views:SettingsCard>
                        </fa:SettingsExpander.Items>
                    </fa:SettingsExpander>

                    <!-- 版本记录：内容走 Items（渲染在标题下方的整行区域），
                         不能塞进默认的 Content 位 —— 那样会挤在标题右侧，展开后成为一条窄长的右栏列表
                         ⚠️ 移植说明：Toolkit 的 HeaderIcon → FA 的 IconSource；
                         Toolkit 的 Expanded 事件 FA 没有 → code-behind 里监听 IsExpandedProperty。 -->
                    <fa:SettingsExpander x:Name="HistoryExpander" Header="版本记录"
                                               Description="本机运行过哪些版本，以及可以从仓库装回的旧版本。"
                                               IsExpanded="False">
                        <fa:SettingsExpander.IconSource>
                            <fa:FontIconSource FontFamily="{DynamicResource SymbolThemeFontFamily}" Glyph="&#xE81C;" />
                        </fa:SettingsExpander.IconSource>
                        <fa:SettingsExpander.Items>

                            <views:SettingsCard Header="本机运行过的版本">
                                <views:SettingsCard.Description>
                                    <StackPanel Spacing="4" Margin="0,4,0,0">
                                        <TextBlock Text="应用每次启动都会记一条（时间为本机时间），按时间倒序。"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <StackPanel x:Name="LocalHistoryList" Spacing="6" />
                                    </StackPanel>
                                </views:SettingsCard.Description>
                            </views:SettingsCard>

                            <views:SettingsCard Header="从仓库装回旧版本">
                                <views:SettingsCard.Description>
                                    <StackPanel Spacing="8" Margin="0,4,0,0">
                                        <TextBlock Text="从更新仓库加载可回滚的版本（正式版与 Insider 版）。装回旧版会覆盖当前程序文件，设置与软件内容不受影响。"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="LoadHistoryButton" Content="从仓库加载可回滚的版本"
                                                    Click="LoadHistory_Click" />
                                            <fa:ProgressRing x:Name="HistoryRing" Width="20" Height="20"
                                                          IsActive="False" IsVisible="False" />
                                        </StackPanel>
                                        <StackPanel x:Name="HistoryList" Spacing="6" />
                                    </StackPanel>
                                </views:SettingsCard.Description>
                            </views:SettingsCard>

                        </fa:SettingsExpander.Items>
                    </fa:SettingsExpander>

                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</platform:PageBase>
