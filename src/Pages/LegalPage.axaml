<platform:PageBase
    x:Class="ClassSoftwareHub.Desktop.Pages.LegalPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platform="using:ClassSoftwareHub.Desktop.Platform"
    xmlns:fa="using:FluentAvalonia.UI.Controls">

    <!--
      法律条款页（与网页端「关于 → 法律条款」一致）：用户协议 / 隐私政策 / 免责声明。
      内容由 Services/LegalTextSource 提供：在线优先（站点 public/legal.json） → 本地缓存
      → Data/LegalDocs.cs 内置兜底（2026-11-01 起，与上游 dv1.2.0-insider1.10 同口径）。
      设置页「关于 → 法律条款」的三个入口各自带 Tag（agreement / privacy / disclaimer），
      经 ShellPage.NavigateToLegal(key) 跳进来，参数就是这份文档的 key。

      版式沿用 ChangelogPage：最外层 ScrollViewer 统一滚动，内容钉在中间 960 宽。
      左上角一颗小图标键在中文 / English 之间切（两套文案都已在 LegalDocs 里备好）。
      返回走 ShellPage 左上角的返回按钮（ContentFrame.GoBack）—— 与其他子页一致，不再单独画返回键。
    -->

    <ScrollViewer Padding="24,28,24,44" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="960" HorizontalAlignment="Center" Spacing="8">

            <!-- 语言切换：一颗小图标键（2026-10-12 用户反馈"开关不好看"）。
                 图标 = 地球（Segoe MDL2 "World"），点一下在 中文 / English 之间切；
                 键右侧的小字提示当前可切过去的目标语言，不占地方。 -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="LangButton" Click="LangButton_Click" MinWidth="0" MinHeight="0"
                        Padding="6,4" Background="Transparent" BorderThickness="0"
                        VerticalAlignment="Center" ToolTip.Tip="切换到 English">
                    <fa:FontIcon Glyph="&#xE774;" FontSize="15" />
                </Button>
                <TextBlock x:Name="LangHint" Text="English" FontSize="12" Opacity="0.6"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock x:Name="DocTitle" FontSize="26" FontWeight="Bold" />
                <TextBlock x:Name="DocMeta" FontSize="12" Opacity="0.7" />
            </StackPanel>

            <!--
              拉不到在线条款时才有内容（= 正在显示随程序内置的那份，见 Services/LegalTextSource）。
              ⚠️ 只在「一次都没拉到过」时出现：正常情况用户不需要知道正文是从哪来的，
                 写出来反而像推责。它出现时也只陈述事实，不做解释。
              ⚠️ 关着的 InfoBar 仍占一排高度 → 显式 IsVisible 控制。
            -->
            <fa:InfoBar x:Name="SourceBar" IsOpen="False" IsClosable="False" IsVisible="False"
                        Severity="Informational" Margin="0,4,0,0" />

            <TextBlock x:Name="DocIntro" TextWrapping="Wrap" FontSize="13"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <ItemsControl x:Name="SectionList" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="6" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</platform:PageBase>
