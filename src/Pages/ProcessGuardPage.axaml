<platform:PageBase
    x:Class="ClassSoftwareHub.Desktop.Pages.ProcessGuardPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platform="using:ClassSoftwareHub.Desktop.Platform"
    xmlns:fa="using:FluentAvalonia.UI.Controls"
    xmlns:views="using:ClassSoftwareHub.Desktop.Views">

    <!--
      ⚠️ 移植说明（WinUI → Avalonia/FluentAvalonia）：
        · 原版 Page 根元素上的 NavigationCacheMode="Disabled" —— Avalonia 侧由
          ShellPage 的 <fa:Frame CacheSize="0"/> 统一承担，这里不再单设。
        · ThemeResource → DynamicResource。
        · TextBox.PlaceholderText → Watermark。
        · ToggleSwitch.Toggled → IsCheckedChanged。
        · ⛔ FluentAvalonia 2.4.1 没有导出 TimePicker 控件，时间点一律 TextBox 直填 HH:MM
          （代码侧用 ProcessGuardConfig.IsValidTime 校验）。

      版式与「白板专杀」「本机核实」同源：三列 Grid 把内容钉在中间 960 宽。
      ⚠️ 别用 Stretch + MaxWidth：一旦触发上限 WinUI 会把整列右甩。

      卡片语言（2026-10-02 二改，向设置页看齐）：圆角 4、卡片间距 4、内边距 16,12；
      手写 Border 一律 Classes="cshCard"。
      ⚠️ 移植说明：原版 CommunityToolkit SettingsCard → 本工程自建 views:SettingsCard。
    -->
    <!-- ⚠️ 2026-10-02：ScrollViewer 提到最外层（滚动条贴窗口右缘），边距改 Padding、居中改内层 Grid -->
    <ScrollViewer Padding="24,36,24,44" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="960" HorizontalAlignment="Center">
            <StackPanel Spacing="4">

                <!-- 标题 + 实验性标记 -->
                <StackPanel Spacing="6" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="程序专杀" FontSize="28" FontWeight="Bold" />
                        <Border CornerRadius="4" Padding="8,3" Margin="0,0,0,6" VerticalAlignment="Bottom"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource SystemFillColorCautionBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <fa:FontIcon Glyph="&#xEA80;" FontSize="11"
                                             Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                <TextBlock Text="实验性功能" FontSize="12"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="为指定的程序单独设定结束时间：到达时间点后，若该程序仍驻留于后台，则结束其进程。每条程序规则各自独立配置，互不影响。" />
                </StackPanel>

                <!-- 总开关：SettingsCard 原生控件（与设置页同一套），不再手叠 Border -->
                <views:SettingsCard Header="自动执行">
                    <views:SettingsCard.Description>
                        <TextBlock x:Name="SwitchHint" FontSize="12" Opacity="0.6" TextWrapping="Wrap" Text="" />
                    </views:SettingsCard.Description>
                    <ToggleSwitch x:Name="EnableSwitch" OnContent="开" OffContent="关"
                                  MinWidth="0" IsCheckedChanged="EnableSwitch_Toggled" />
                </views:SettingsCard>

                <!-- 添加规则 -->
                <Border Classes="cshCard">
                    <StackPanel Spacing="10">
                        <TextBlock Text="添加程序" FontSize="14" />
                        <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                   Text="填写进程名即可（例如 chrome、notepad）。可省略 .exe 后缀；不区分大小写。添加后在下方为该程序设定结束时间。" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBox x:Name="NameBox" MinWidth="260" Watermark="进程名" />
                            <Button x:Name="AddRuleButton" Content="添加程序" Click="AddRule_Click"
                                    VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="AddHint" FontSize="12" TextWrapping="Wrap" Opacity="0.75" Text="" />
                    </StackPanel>
                </Border>

                <!-- 规则列表 -->
                <Border Classes="cshCard">
                    <StackPanel Spacing="10">
                        <TextBlock Text="已配置的程序" FontSize="14" />
                        <StackPanel x:Name="RulesHost" Spacing="12" />
                    </StackPanel>
                </Border>

                <!-- 手动执行 -->
                <Border Classes="cshCard">
                    <StackPanel Spacing="10">
                        <TextBlock Text="立即执行一次" FontSize="14" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="CheckButton" Content="仅检测" Click="Check_Click" />
                            <Button x:Name="CleanButton" Content="立即结束" Click="Clean_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ResultText" FontSize="12" TextWrapping="Wrap" Opacity="0.75" Text="" />
                    </StackPanel>
                </Border>

                <!-- 当前命中进程 -->
                <Border Classes="cshCard">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="当前命中的进程" FontSize="14" VerticalAlignment="Center" />
                            <Button x:Name="RefreshButton" Content="刷新" Click="Refresh_Click"
                                    FontSize="12" Padding="10,4,10,4" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="ProcHost" Spacing="4" />
                    </StackPanel>
                </Border>

                <!-- 页脚：说明判定依据与局限 -->
                <Border Classes="cshCard">
                    <StackPanel Spacing="7">
                        <TextBlock Text="执行依据与限制" FontSize="12" FontWeight="Bold" Opacity="0.85" />
                        <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   Text="· 匹配方式：按进程名逐字比较，忽略大小写，.exe 后缀可省略。「chrome」与「chrome.exe」视为同一个程序。" />
                        <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   Text="· 判「是否正在使用」：仅检查该进程有无可见的顶层窗口。存在可见窗口即判定为正在使用，按规则设定跳过；无可见窗口的后台驻留进程才会被结束。" />
                        <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   Text="· 生效条件：本程序需处于运行状态。本程序完全退出后，到达时间点也不会执行（执行依赖本程序自身的计时，未向系统注册计划任务）。" />
                        <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   Text="· 结束失败的常见原因：目标进程的权限高于本程序（例如以管理员身份运行）。此时结果区会如实记录，不会标记为成功。" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</platform:PageBase>
