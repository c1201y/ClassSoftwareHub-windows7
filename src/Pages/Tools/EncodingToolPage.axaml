<platform:PageBase
    x:Class="ClassSoftwareHub.Desktop.Pages.Tools.EncodingToolPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platform="using:ClassSoftwareHub.Desktop.Platform"
    xmlns:fa="using:FluentAvalonia.UI.Controls"
    xmlns:tools="using:ClassSoftwareHub.Desktop.Pages.Tools">

    <!-- ═══ 2026-10-02 四次重排（Nick：「所有块都是方块包方块，像一张填满格子的 Excel」）═══
         前三版一直在解决"拖拽区占篇幅""哈希值被挤到下面"这类比例问题，
         但外壳一直没动过 —— 每个功能块都套一张手写 Border，四层叠下来又厚又平，没有层级。

         这一版按"能少一层就少一层"重排：
           ① 「用途」从两张并排大卡降级为**一行原生 RadioButton**（两个选项照样都看得见）；
           ② 拖拽区从"描边卡片"改成**淡色底、不描边**的扁平块，只保留一条提示语；
           ③ 核对行去掉卡片外壳，标签交给 TextBox 自带的 Header；
           ④ 四条哈希值改用 **ListView 承载**（App.axaml 的 CshResultRowStyle 等价物）：
              每行自带系统悬停底色，最外面那张大卡片整个删掉 —— 只读结果不该长得像能编辑的表格。
         仅"输入文本 / 输出结果"两块仍保留卡片：它们确实是两个互不相干的模块。

         ⚠️ 移植说明：
           · 根节点 Page → platform:PageBase；
           · ThemeResource → DynamicResource；Visibility → IsVisible；
           · Grid.ColumnSpacing / RowSpacing → 子元素 Margin 模拟（间距值照搬）；
           · TextBox.Header（WinUI 才有）→ Avalonia 的 TextBox 没有 Header，外包一层「小字标题 + TextBox」；
           · ListView.ItemContainerStyle="{StaticResource CshResultRowStyle}" →
             改给 ListView 打 Classes="cshResultRows"（App.axaml 里的 Class 选择器等价物，见其注释）；
           · x:Bind → {Binding}（反射绑定，DataTemplate 不加 x:DataType）；
           · 原版 GridView 禁用滚动那套（ScrollViewer.VerticalScrollBarVisibility）照搬到 ListView。 -->
    <!--
      ⚠️ 移植说明：上游在这里放了一个 `x:Key="HashRowTemplate"` 的 DataTemplate（ListView.ItemTemplate 用，
      行里带一个 Click="CopyHashRow_Click" 的复制键）。本移植版**不用它**，两个原因：
        ① Avalonia 无 ListView（只有 ListBox），且 **ResourceDictionary 里的 DataTemplate 不参与事件
           绑定解析** —— `Click="某某_Click"` 会被当成普通字符串属性值直接编译失败；
        ② 本仓库既有的做法是代码后置建行（见 EncodingToolPage.axaml.cs 的 BuildHashRows），
           值的刷新靠持有的控件字典，不必引入 HashRow + ObservableCollection 那一套。
      视觉与交互与上游一致：容器是 ListBox + Classes="cshResultRows"（App.axaml 的等价样式），
      行容器 ListBoxItem 自带系统悬停底色 / 圆角 / 键盘导航。
    -->

    <!-- 三列钉宽：内容钉在中间、两侧吸收余量（上游工具页加的内容列，上游值 1008；
         这里取本移植版全站通用的 960 内容列宽，与设置页 / 软件下载页同一套）。 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="998*" MaxWidth="960" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
    <Grid Grid.Column="1" Margin="24,14,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="编码 / 哈希工具" FontSize="28" FontWeight="Bold" />
            <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                       Text="校验文件：拖入文件即得四种哈希值，粘贴官方提供的哈希值会立即给出核对结论。也可对文本做 Base64 / URL 编解码。全部在本机完成。" />
        </StackPanel>

        <!-- ═══ 2026-10-02：两个用途从「两张卡片」降级为**一行原生单选** ═══
             前三版用两张并排大卡，一眼看到还有另一条路是对的，但两块卡片占了整整一屏高。
             原生 RadioButton 也照样两个选项都看得见，只是不再抢内容的高度。
             ⚠️ MinWidth 必须清零（RadioButton 默认 120）；IsChecked 一律在代码里赋初值。 -->
        <StackPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="用途" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,2,0" />
            <RadioButton x:Name="FileTab" GroupName="EncMode" Content="校验文件" MinWidth="0"
                         AutomationProperties.Name="校验文件" Checked="Mode_Changed" />
            <RadioButton x:Name="TextTab" GroupName="EncMode" Content="文本编解码" MinWidth="0"
                         AutomationProperties.Name="文本编解码" Checked="Mode_Changed" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <!-- ══════════ 文件校验 ══════════ -->
            <ScrollViewer x:Name="FileView" VerticalScrollBarVisibility="Auto">
                <!-- ⛔ 底部 Margin 是保险栓：外层 Grid 的 Padding 底部在滚动区**之外**，
                     实测滚到底最后一项仍会贴住窗口底边。留白必须写在滚动区**里**才可靠。 -->
                <StackPanel Margin="0,0,0,20">

                    <!-- 从软件详情页的「校验」键跳进来时才有：说明校验值是从哪来的 -->
                    <TextBlock x:Name="FromAppHint" IsVisible="False" FontSize="12"
                               TextWrapping="Wrap" Opacity="0.85" />

                    <!-- ① 选文件：一条扁平横条，整条都能拖、能点 ——
                         只铺一层淡底、不描边，不再是"又一张卡片"。 -->
                    <Border x:Name="DropZone" Margin="0,10,0,0" Padding="14,12,14,12" CornerRadius="4" BorderThickness="0"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            DragDrop.AllowDrop="True" Tapped="DropZone_Tapped"
                            DragDrop.DragOver="File_DragOver" DragDrop.DragLeave="File_DragLeave" DragDrop.Drop="File_Drop">
                        <!-- ColumnSpacing="12" → 第 1/2 列 Margin -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <fa:FontIcon Glyph="&#xE8E5;" FontSize="20" Opacity="0.65"
                                      VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="DropHintText" Text="把文件拖到这里，或单击选择"
                                           FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="SourceText" FontSize="11.5" Opacity="0.6"
                                           TextTrimming="CharacterEllipsis"
                                           Text="支持任意文件类型，大文件流式读取" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="12,0,0,0" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <Button x:Name="PickFileButton" Content="选择文件" Click="PickFile_Click" />
                                <Button x:Name="ClearFileButton" Content="清除" Click="ClearFile_Click"
                                        IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ProgressBar x:Name="HashProgress" Margin="0,12,0,0" IsIndeterminate="True" IsVisible="False" />

                    <!-- ② 核对：标签 + 粘贴框 + 结论压在一行，结论放大加粗 ——
                         粘完那一瞬间最想看到的就是这五个字，别让它藏在 13px 的正文里。 -->
                    <Border Margin="0,12,0,0" CornerRadius="10" Padding="14" BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <!-- ColumnSpacing="12" → 第 1/2 列 Margin -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="核对官方哈希值" FontSize="12.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <!-- PlaceholderText → Avalonia TextBox 用 Watermark（语义相同） -->
                            <TextBox x:Name="ExpectedBox" Grid.Column="1" Margin="12,0,0,0"
                                     Watermark="在此粘贴官网给出的 MD5 / SHA-1 / SHA-256 / SHA-512 值（空格、大小写、冒号均可忽略）"
                                     FontFamily="Consolas" FontSize="12.5" TextChanged="Expected_TextChanged" />
                            <TextBlock x:Name="MatchText" Grid.Column="2" Margin="12,0,0,0" FontSize="15" FontWeight="Bold"
                                       VerticalAlignment="Center" MaxWidth="300" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <!-- ③ 结果 -->
                    <Border Margin="0,12,0,0" CornerRadius="10" Padding="16,12,16,12" BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="文件哈希值" FontSize="13" FontWeight="Bold" Margin="0,0,0,2" />
                            <!-- 四行由 BuildHashRows 铺出来：算法名 · 值 · 复制。
                                 ⚠️ 移植：上游 dv1.1.0 把这块从"手画分隔线的表格"换成 ListView +
                                 ItemContainerStyle（= App.xaml 的 CshResultRowStyle），让每行自带系统
                                 悬停底色与圆角。Avalonia 无 ListView → 用 ListBox（等价物，行容器是
                                 ListBoxItem，悬停/圆角/键盘导航一样由系统提供），样式走 App.axaml 的
                                 `ListBox.cshResultRows` 选择器 + Classes="cshResultRows"。
                                 ⛔ SelectionMode=None（只读结果，不参与选中）+ 禁自身滚动条
                                    （它待在外层 ScrollViewer 里，不禁会出现内外两层滚动条）。 -->
                            <ListBox x:Name="HashPanel" Classes="cshResultRows" SelectionMode="Single"
                                     Background="Transparent" BorderThickness="0" Padding="0" Margin="0,4,0,0"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══════════ 文本编解码 ══════════ -->
            <ScrollViewer x:Name="TextView" VerticalScrollBarVisibility="Auto" IsVisible="False">
                <StackPanel>
                    <!-- ColumnSpacing="14" → 第 1 列 Margin -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border CornerRadius="10" Padding="16" BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <!-- Spacing="10" → 除第一个子元素外逐个加顶 Margin -->
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="输入文本" FontSize="13" FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                    <!-- 清空：原来只能全选删掉，贴一大段文本后想重来很别扭 -->
                                    <Button Grid.Column="1" Content="清空" Click="ClearInput_Click"
                                            Padding="10,2,10,2" FontSize="12.5" />
                                </Grid>
                                <TextBox x:Name="InputBox" Margin="0,10,0,0" AcceptsReturn="True" TextWrapping="Wrap" Height="168"
                                         Watermark="输入文本（支持中文）" FontFamily="Consolas" FontSize="13"
                                         TextChanged="Input_TextChanged" />

                                <!-- 四个按钮平铺分不清哪个是哪种编码 → 改成"左边给算法、右边给方向"的表格型排布，
                                     同一列永远是同一个动作（右=解码），肌肉记忆直接建立。 -->
                                <!-- ColumnSpacing="8" RowSpacing="8" → Margin 模拟 -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Base64" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="编码" Click="B64Enc_Click"
                                            HorizontalAlignment="Stretch" FontSize="13" />
                                    <Button Grid.Column="2" Margin="8,0,0,0" Content="解码" Click="B64Dec_Click"
                                            HorizontalAlignment="Stretch" FontSize="13" />

                                    <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="URL" FontSize="12" Opacity="0.7"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Content="编码" Click="UrlEnc_Click"
                                            HorizontalAlignment="Stretch" FontSize="13" />
                                    <Button Grid.Row="1" Grid.Column="2" Margin="8,8,0,0" Content="解码" Click="UrlDec_Click"
                                            HorizontalAlignment="Stretch" FontSize="13" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Margin="14,0,0,0" CornerRadius="10" Padding="16" BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="输出结果" FontSize="13" FontWeight="Bold" />
                                <TextBox x:Name="OutputBox" Margin="0,10,0,0" AcceptsReturn="True" TextWrapping="Wrap" Height="168"
                                         Watermark="转换结果" FontFamily="Consolas" FontSize="13"
                                         TextChanged="Output_TextChanged" />
                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="CopyOutButton" Content="复制结果" Click="CopyOut_Click"
                                            IsEnabled="False" Padding="10,0,10,0" FontSize="13" />
                                    <Button x:Name="UseOutputButton" Content="替换输入" Click="UseOutput_Click"
                                            IsEnabled="False" Padding="10,0,10,0" FontSize="13" />
                                </StackPanel>
                                <TextBlock x:Name="StatusText" Margin="0,10,0,0" FontSize="12.5" Opacity="0.6" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 文本的哈希：跟输入框实时联动，所以单独成一块，不与"文件哈希"共用显示区 -->
                    <Border Margin="0,12,0,0" CornerRadius="10" Padding="16,12,16,12" BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="这段文本的哈希值" FontSize="13" FontWeight="Bold" />
                            <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                       Text="随上方输入框的内容实时计算，无需单击任何按钮。" Margin="0,0,0,2" />
                            <ListBox x:Name="TextHashPanel" Classes="cshResultRows" SelectionMode="Single"
                                     Background="Transparent" BorderThickness="0" Padding="0" Margin="0,4,0,0"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock x:Name="Toast" Grid.Row="3" Margin="0,10,0,0" FontSize="12" Opacity="0.75" />
    </Grid>
    </Grid>
</platform:PageBase>
