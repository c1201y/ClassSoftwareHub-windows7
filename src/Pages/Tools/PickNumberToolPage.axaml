<platform:PageBase
    x:Class="ClassSoftwareHub.Desktop.Pages.Tools.PickNumberToolPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platform="using:ClassSoftwareHub.Desktop.Platform"
    xmlns:fa="using:FluentAvalonia.UI.Controls">

    <!-- ═══ 2026-10-02 上游第四次重排（Nick：「典型的左右分栏仪表盘割裂，左挤右空」）═══
         前三版一直在解决"入口看不看得见"，版式却始终是**左设置 / 右结果**两栏：
         左边 286 宽塞满输入框和按钮，右边一大片空地上孤零零一个数字。
         这是网页仪表盘的思路 —— 桌面小工具不该让"设置"和"主角"平起平坐。

         上游这一版回到**单列、竖着排**，按"主角—配角"重新分配视觉重心：

           ┌ 标题
           ├ 一行紧凑的选择项（功能 · 抽取对象）—— 都是原生 RadioButton，两个选项都看得见
           ├ 一条参数带（范围 / 数量 / 不重复），右边挂池子状态
           ├ ★ 结果舞台：占据剩下的全部高度，抽出来的号大字居中，这是这一页的主角
           ├ 「开始抽号」强调色主按钮（全页唯一的 Accent）
           └ 已抽记录 / 设置摘要 / 公平性自检 —— 全是小字，退到页脚

         ⛔ 别退回左右分栏；⛔ 别给结果舞台加强调色描边（Accent 只能有一个，就是那颗按钮）。

         ⚠️ 2026-10-07：本文件按上游 dv1.1.0 的这版布局**整体重写**（此前移植版还停在
            上游 2026-09-29 的「四张大卡 + 左右分栏」版，与 Win10 版差距最大的一页）。

         ⚠️ 移植说明：
           · Page → platform:PageBase；ThemeResource → DynamicResource；
             ToolTipService.ToolTip → ToolTip.Tip；Visibility="Collapsed" → IsVisible="False"；
             Grid.RowSpacing / ColumnSpacing → 子元素 Margin 模拟（数值照搬）。
           · RadioButton 的卡片样式 CshModeCardStyle 不再使用 —— 上游已改回原生 RadioButton
             （一条横行放得下，占地只有原来四张大卡的零头，省下的高度全给结果舞台）。
           · NumberBox → fa:NumberBox（FluentAvalonia 提供，属性名一致）。
           · VariableSizedWrapGrid(ItemWidth/ItemHeight) → WrapPanel：格子尺寸由代码给
             （见 PickNumberToolPage 里 NumberCellWidth 的注释 —— 定高会把长名字裁掉）。
           · HyperlinkButton → 透明底 + 强调色的 Button（Avalonia 没有 HyperlinkButton）。
           · ComboBox 没有 Header 属性 → 「分组方式」用小字 TextBlock 摆在它上方还原。
           · ⚠️ **本页独有的移植增量**：上游没有字号调节，本版保留「结果字号」滑块
             （2026-10-06 用户反馈"结果区那么大为什么要放两行"→ 结果改单行 + 字号可调；
              2026-10-07 Nick 反馈"字号要可以再大一点" → 上限 2.0 提到 3.0）。
             位置选在参数带右列（它本就是"参数"），不占主流程。 -->
    <Grid Margin="24,10,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ 标题 ═══ -->
        <!-- ColumnSpacing="12" → 第 1 列 Margin -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="随机抽号" FontSize="28" FontWeight="Bold" />
                <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                           Text="随机抽取学号或学生姓名，也可一键随机分组。号码取自系统加密随机数，结果公平可靠。" />
            </StackPanel>
            <Button Grid.Column="1" Margin="12,0,0,0" Content="在工具窗口打开" VerticalAlignment="Center"
                    Click="OpenPalette_Click" ToolTip.Tip="打开置顶小窗口，便于随时抽号" />
        </Grid>

        <!-- ═══ 选择项：功能 / 抽取对象 ═══
             ⚠️ 用原生 RadioButton，不套卡片：一条横行放得下，两个选项同时可见（不会藏功能），
                占地却只有原来那四张大卡的零头 —— 省下来的高度全给下面的结果舞台。
             ⚠️ MinWidth 必须清零：RadioButton 默认 MinWidth=120，不清零会拉开一片空当。
             ⚠️ IsChecked 一律在代码里赋初值，不写在这里（见 App.axaml 里 CshModeCardStyle 的注释）。 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="28" VerticalAlignment="Center"
                    Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="功能" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,2,0" />
                <RadioButton x:Name="TaskDrawRadio" GroupName="TaskMode" Content="抽号" MinWidth="0"
                             Checked="TaskMode_Changed" />
                <RadioButton x:Name="TaskGroupRadio" GroupName="TaskMode" Content="随机分组" MinWidth="0"
                             Checked="TaskMode_Changed" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="抽取对象" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,2,0" />
                <!-- 2026-10-03（上游 Nick）：旧文案「按号码/按名单」太随意，改成说动作本身，
                     与浮窗版 MiniPickNumber 保持一致。 -->
                <RadioButton x:Name="ModeRangeRadio" GroupName="PoolMode" Content="抽取座号" MinWidth="0"
                             AutomationProperties.Name="抽取座号" Checked="PoolMode_Changed" />
                <RadioButton x:Name="ModeRosterRadio" GroupName="PoolMode" Content="使用名单" MinWidth="0"
                             AutomationProperties.Name="使用名单" Checked="PoolMode_Changed" />
            </StackPanel>
        </StackPanel>

        <!-- ═══ 内容：抽号 / 随机分组 ═══ -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <!-- ══════════ 抽号 ══════════ -->
            <!-- VerticalContentAlignment=Stretch：让内容在窗口够高时铺满可视高度，
                 结果舞台才能真的"占住剩下的全部地方"，而不是缩成一条。 -->
            <ScrollViewer x:Name="DrawView" VerticalScrollBarVisibility="Auto"
                          VerticalContentAlignment="Stretch">
                <!-- ⛔ 底部 Margin 是保险栓：外层 Grid 的 Margin 底部在滚动区**之外**，
                     实测滚到底仍会贴住窗口底边 —— 留白必须写在滚动区**里**。 -->
                <Grid Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="240" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ── 参数带：范围 / 数量 / 不重复，全挤在一行 ──
                         右边那句状态（池子多大 / 抽掉多少 / 还剩多少）属于"池子"，
                         就该待在定义池子的这一行里。 -->
                    <Border CornerRadius="10" Padding="16,8,16,8" BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <!-- ⚠️ 2026-10-07：第 0 列必须是 **Auto**，不能是 `*`。
                             参数行（号码范围 + 抽取数量 + 不重复）是定宽控件拼出来的，宽度是写死的；
                             给它一个 `*` 格子时，窗口一窄它就**撑爆自己的格子往右溢出** ——
                             实测 983dip 宽的窗口下，「不重复」和右列的「结果字号」直接叠在一起
                             （UIA 实测横向重叠 36px，截图里两个字都糊成一团）。
                             Auto 让它拿到"刚好够用"的宽度，右边的池子状态去吃剩下的 `*`，
                             于是参数行永远压不到右列上。 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 参数区（两行格）：行 0 放"抽取池"本身，行 1 放"这一批抽多少"。
                                 ⚠️「抽取数量 / 不重复」摆哪一行**由 SyncPoolMode() 按模式决定**（上游 dv1.1.1）：
                                    · 号码模式 → 并到行 0 的右边，整条参数带仍是一行（与旧版一致）；
                                    · 名单模式 → 落到行 1 独占一行。名单那一排（标签 + 四个按钮）本来就长，
                                      同一行再塞数量框，窗口一窄就会被裁掉。
                                 ⚠️ 上游 Grid 的 ColumnSpacing="22" → 这里用 BatchPanel 的 Margin 模拟。 -->
                            <Grid x:Name="ParamGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 号码：只剩范围（数量 / 不重复 已挪到两种模式共用的 BatchPanel） -->
                                <StackPanel x:Name="RangePanel" Orientation="Horizontal" Spacing="10"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="号码范围" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <!-- ⚠️ NumberBox 的 Maximum 必须填：不填的话在框里粘一个大数字（比如一亿），
                                         后面 Enumerable.Range(Lo, size) 会瞬间申请几 GB → 界面冻死或直接 OOM。
                                         上限与浮窗版保持一致；代码里另有一道夹取兜底。 -->
                                    <!-- ⚠️⛔ 步进一律用 **Inline**，别换回 Compact（上游 2026-10-05 Nick 截图反馈）：
                                         Compact 是"点一下才弹一个小面板"，触屏上那个浮层既取消不掉
                                         （点别处不收起），里面的加/减也点不动 —— 等于这个框没法用。
                                         Inline 把上/下按钮直接做进框里（常驻、整高），一次点到位。
                                         宽度要跟着给足（104 → 124）：Inline 两个按钮各占约 32，窄了会把数字挤没。 -->
                                    <fa:NumberBox x:Name="FromBox" Value="1" Minimum="0" Maximum="9999"
                                                  SmallChange="1" SpinButtonPlacementMode="Inline" Width="124" />
                                    <TextBlock Text="~" VerticalAlignment="Center" Opacity="0.6" />
                                    <fa:NumberBox x:Name="ToBox" Value="50" Minimum="0" Maximum="9999"
                                                  SmallChange="1" SpinButtonPlacementMode="Inline" Width="124" />
                                </StackPanel>

                                <!-- 名单：导入 / 示例 / 查看修改 / 清空
                                     ⚠️「查看 / 编辑名单」为什么是弹窗而不是就地把列表摆在这儿：
                                        本机窗口可用高度有限，就地摆一个 ListView 实测被压到 19px（等于看不见）。
                                        弹窗能给它 400+ 的高度，一屏能核对十几个人，也不占主流程的地方。 -->
                                <!-- ColumnSpacing="10" → 用 StackPanel.Spacing 模拟 -->
                                <StackPanel x:Name="RosterPanel" Orientation="Horizontal" Spacing="10"
                                            VerticalAlignment="Center" IsVisible="False">
                                    <TextBlock Text="名单文件" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <Button Content="导入名单" Click="ImportRoster_Click" />
                                    <!-- 导入之前先让人看见"名单文件该长什么样"（图 + 可下载的示例） -->
                                    <Button Content="示例名单" Click="SampleRoster_Click"
                                            ToolTip.Tip="看看名单文件该怎么做，也可直接下载一份示例照着填" />
                                    <Button x:Name="OpenRosterButton" Content="查看 / 编辑名单"
                                            Click="OpenRoster_Click"
                                            ToolTip.Tip="列出名单里的每个人，可逐个改名、删除，也可导出成 Excel 或 txt" />
                                    <Button x:Name="ClearRosterButton" Content="清空名单"
                                            Click="ClearRoster_Click" IsEnabled="False" />
                                </StackPanel>

                                <!-- 两种模式共用「这一批抽多少」（上游 dv1.1.1，浮窗版 MiniPickNumber 也是共用的）。
                                     ⚠️ 上限**不写死在这里**：由 RefreshHints 按当前池子夹 ——
                                        名单模式跟人数、号码模式跟号码范围，池子只有 10 个时框里填不出 11。
                                     ⚠️ 步进用 Inline，理由同上面的号码框（Compact 的浮层在触屏上点不动）。 -->
                                <StackPanel x:Name="BatchPanel" Orientation="Horizontal" Spacing="10"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="抽取数量" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <fa:NumberBox x:Name="CountBox" Value="1" Minimum="1" Maximum="9999"
                                                  SmallChange="1" SpinButtonPlacementMode="Inline" Width="124" />
                                    <CheckBox x:Name="NoRepeatBox" Content="不重复" MinWidth="0"
                                              Padding="6,0,0,0" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- 右列：池子状态（与上游一致，**只有这一项**）。
                                 ⚠️ 2026-10-07：「结果字号」滑块原先也摆在这一列，但它有 228dip 宽，
                                    和左边的参数行抢宽度 —— 窗口一窄（实测 983dip 宽的窗口，
                                    内容区约 850dip），参数行就撑爆自己的格子、
                                    「不重复」直接压在「结果字号」上（UIA 实测重叠 36px）。
                                    现在滑块挪进结果卡片右上角：它本来就是"结果的字号"，
                                    挨着它管的东西才对。 -->
                            <TextBlock x:Name="PoolStatusText" Grid.Column="1" Margin="16,0,0,0"
                                       FontSize="12" FontWeight="SemiBold"
                                       Opacity="0.8" VerticalAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="420" TextAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- ── 结果舞台：这一页的主角，占掉剩下的全部高度 ──
                         不再用强调色描边（Accent 全页只留给主按钮），改成一块素净的浅底，
                         让大字自己立住。 -->
                    <Border x:Name="ResultCard" Grid.Row="1" Margin="0,10,0,0" CornerRadius="10" Padding="20"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Grid>
                            <TextBlock x:Name="ResultHint" Text="单击下方「开始抽号」" FontSize="12" Opacity="0.55"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <!-- VariableSizedWrapGrid(ItemWidth/ItemHeight) → WrapPanel：
                                 格子尺寸由代码给（见 PickNumberToolPage.NumberCellWidth 的注释 ——
                                 定高会把长名字裁掉，就是 2026-10-06「字显示不开」的成因）。 -->
                            <WrapPanel x:Name="ResultHost" Orientation="Horizontal"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <!-- 结果字号（本移植版增量，上游没有）：结果改单行显示后，字号交给这颗滑块；
                                 长名字自己缩小即可，号码结果也吃这个缩放（见 ShowResult）。
                                 摆右上角、压在结果上面，永远是它在管的那块内容。 -->
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="结果字号" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Opacity="0.75" />
                                <Slider x:Name="NameScaleSlider" Width="120" Minimum="0.5" Maximum="3"
                                        Value="1" VerticalAlignment="Center"
                                        ValueChanged="NameScaleSlider_Changed" />
                                <TextBlock x:Name="NameScaleText" Width="42" FontSize="12" Opacity="0.8"
                                           TextAlignment="Right" VerticalAlignment="Center" Text="100%" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── 主操作：全页唯一的强调色按钮，居中 ── -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="8" HorizontalAlignment="Center">
                        <Button x:Name="DrawButton" Content="开始抽号"
                                Theme="{StaticResource AccentButtonStyle}" Click="Draw_Click"
                                MinWidth="280" Height="44" FontSize="15" />
                        <!-- 出错提示紧贴按钮：原来甩在结果区下面，用户点完不知道哪儿不对 -->
                        <TextBlock x:Name="ErrorText" FontSize="12" TextAlignment="Center"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   TextWrapping="Wrap" IsVisible="False" />
                    </StackPanel>

                    <!-- ── 抽号记录：抽完立刻能回看 ── -->
                    <!-- ColumnSpacing="10" → 第 1 列 Margin -->
                    <Grid x:Name="UsedRow" Grid.Row="3" Margin="0,10,0,0" IsVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="UsedText" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Margin="10,0,0,0" Content="重置记录" Click="ResetUsed_Click" />
                    </Grid>

                    <!-- ── 页脚：设置摘要 + 公平性自检，都是小字 ── -->
                    <!-- ColumnSpacing="12" → 第 1 列 Margin -->
                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SummaryText" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <!-- 公平性自检：低频的排查工具（实抽 2 万次看分布）。
                             上游是 HyperlinkButton；Avalonia 没有对应控件 →
                             透明底 + 强调色前景的 Button（Padading 清零、贴右）。 -->
                        <Button x:Name="FairLink" Grid.Column="1" Margin="12,0,0,0" Content="公平性自检" Padding="0"
                                VerticalAlignment="Center" Click="FairCheck_Click"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                ToolTip.Tip="在本机实抽 2 万次，检验号码分布是否均匀" />
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- ══════════ 随机分组：同样单列，设置在上、结果在下 ══════════ -->
            <ScrollViewer x:Name="GroupView" VerticalScrollBarVisibility="Auto" IsVisible="False">
                <StackPanel Margin="0,0,0,20" Spacing="10">
                    <!-- 分组设置压成一条横带：方式 / 组数 / 开始 / 复制，全都紧挨着 -->
                    <Border CornerRadius="10" Padding="16,12,16,12" BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <!-- ⚠️ 两个控件都"自带标题"（"分组方式""组数/每组人数"）：
                                 NumberBox 有 Header 属性（代码里按模式换字），
                                 ComboBox 没有 → 用小字 TextBlock 摆在它上方；
                                 按钮用 Bottom 对齐，才能跟输入框的**本体**齐平，而不是跟标题齐平。 -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <StackPanel VerticalAlignment="Bottom" Spacing="4">
                                    <TextBlock Text="分组方式" FontSize="12" />
                                    <ComboBox x:Name="GroupModeBox" MinWidth="150" />
                                </StackPanel>
                                <fa:NumberBox x:Name="GroupValueBox" Value="4" Minimum="1"
                                              Maximum="9999" SmallChange="1" SpinButtonPlacementMode="Compact"
                                              Width="150" VerticalAlignment="Bottom" />
                                <Button x:Name="GroupButton" Content="开始分组"
                                        Theme="{StaticResource AccentButtonStyle}" Click="Group_Click"
                                        VerticalAlignment="Bottom" />
                                <Button x:Name="CopyGroupsButton" Content="复制分组结果" Click="CopyGroups_Click"
                                        IsEnabled="False" VerticalAlignment="Bottom"
                                        ToolTip.Tip="按「第 N 组：姓名、姓名…」的格式复制到剪贴板" />
                            </StackPanel>

                            <TextBlock x:Name="GroupRangeHint" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            <!-- 用户最常问的就是"能分几次" —— 直接写在设置区里 -->
                            <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                       Text="每次单击「开始分组」都会重新打散一次，可反复使用、没有次数限制，也不影响抽号那边的「不重复」记录。" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="GroupHint" Text="单击上方「开始分组」后，各组名单按行列出。"
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    <StackPanel x:Name="GroupsHost" Spacing="10" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock x:Name="Toast" Grid.Row="3" Margin="0,8,0,0" FontSize="12" Opacity="0.75" />
    </Grid>
</platform:PageBase>
