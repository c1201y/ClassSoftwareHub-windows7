<platform:PageBase
    x:Class="ClassSoftwareHub.Desktop.Pages.Tools.MessageToolPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platform="using:ClassSoftwareHub.Desktop.Platform"
    xmlns:fa="using:FluentAvalonia.UI.Controls">

    <!--
      桌面留言：把一句话写出来，做成**桌面悬浮窗**随时看，或**全屏**铺满屏幕展示。
      2026-10-06（Nick 提）：常用工具里加一个留言功能 —— 可输入文字、调字号与颜色，
      还能做成文字悬浮窗在桌面显示和全屏。

      ⚠️ 2026-10-31（Nick：「把桌面留言界面 UI 改改，仿照教室喊话」→「把设置都放一页更好吧」）：
        版式对齐 AnnouncePage —— 标题行 + 单列卡片（左标题/说明、右控件或右侧按钮），
        卡片间距 12、整页 MaxWidth 960。所有设置直接铺在一页里，不藏着分页。
        原来是 352 固定左栏 + 右侧预览的两栏排版，屏幕一窄就挤。

      ⚠️ 移植说明（WinUI → Avalonia）：
        · ThemeResource → DynamicResource；ToolTipService.ToolTip → ToolTip.Tip；
        · 卡片统一走 App.axaml 里的 Classes="cshCard"（4px 圆角 + 系统卡片底/描边 + 16,12 内边距）；
        · Grid 的 RowSpacing / ColumnSpacing 在 Avalonia 里没有 → 用子元素的 Margin 模拟（与 AnnouncePage 一致）；
        · 色卡（一排小色块）在 code-behind 里铺，不在这里手写二十个 Button。
    -->
    <Grid Margin="24,10,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ 标题行 ═══ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="桌面留言" FontSize="24" FontWeight="Bold" />
                <TextBlock FontSize="12.5" Opacity="0.6" TextWrapping="Wrap"
                           Text="把要提醒的话写下来：可调字号与颜色，既能做成置顶悬浮窗钉在桌面上，也能全屏铺满屏幕展示。" />
            </StackPanel>
            <Button Grid.Column="1" Margin="12,0,0,0" Content="在工具窗口打开" VerticalAlignment="Center"
                    Click="OpenPalette_Click" ToolTip.Tip="打开置顶小窗口，随手改字、随手投屏" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="960" HorizontalAlignment="Stretch" Spacing="12">

                <Border Classes="cshCard">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="留言内容" FontSize="13" FontWeight="Bold" />
                            <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                       Text="悬浮窗和全屏展示的都是这段文字；换行会原样保留。" />
                        </StackPanel>
                        <TextBox x:Name="ContentBox" Height="148" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Watermark="在这里输入要展示的文字，可换行"
                                 TextChanged="Content_Changed" />
                        <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                   Text="文字不多时建议用短句，全屏展示时字号会自动放得更大。" />
                    </StackPanel>
                </Border>

                <Border Classes="cshCard">
                    <StackPanel>
                        <TextBlock Text="展示方式" FontSize="13" FontWeight="Bold" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="桌面悬浮窗" FontSize="12.5" />
                                <TextBlock FontSize="11.5" Opacity="0.65" TextWrapping="Wrap"
                                           Text="置顶钉在桌面上，可拖到任意位置；双击、按 Esc 或点关闭键收起。" />
                            </StackPanel>
                            <Button x:Name="FloatButton" Grid.Column="1" Content="悬浮显示" Margin="12,0,0,0"
                                    Theme="{StaticResource AccentButtonStyle}" Padding="18,7" Height="34"
                                    VerticalAlignment="Center" Click="Float_Click"
                                    ToolTip.Tip="把留言钉在桌面上（置顶、可拖动，双击或 Esc 收起）" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="全屏展示" FontSize="12.5" />
                                <TextBlock FontSize="11.5" Opacity="0.65" TextWrapping="Wrap"
                                           Text="铺满整块屏幕，适合投影或班会；字号按「字号 × 全屏放大倍数」自动计算。" />
                            </StackPanel>
                            <Button x:Name="FullscreenButton" Grid.Column="1" Content="全屏显示" Margin="12,0,0,0"
                                    Padding="18,7" Height="34" VerticalAlignment="Center" Click="Fullscreen_Click"
                                    ToolTip.Tip="铺满整块屏幕展示留言（Esc、双击或右上角按钮退出）" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="收起桌面留言" FontSize="12.5" />
                                <TextBlock FontSize="11.5" Opacity="0.65" TextWrapping="Wrap"
                                           Text="关掉桌面上的留言悬浮窗；全屏窗请用 Esc 或右上角按钮退出。" />
                            </StackPanel>
                            <Button x:Name="HideButton" Grid.Column="1" Content="收起" Margin="12,0,0,0"
                                    Padding="18,7" Height="34" VerticalAlignment="Center" Click="Hide_Click"
                                    ToolTip.Tip="关掉桌面上的留言悬浮窗" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="cshCard">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="预览" FontSize="13" FontWeight="Bold" />
                                <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                           Text="按比例缩小显示颜色与字体效果；悬浮窗与全屏显示的是你设定的真实字号。" />
                            </StackPanel>
                            <TextBlock x:Name="PreviewHint" Grid.Column="1" Text="预览" FontSize="12" Opacity="0.45"
                                       VerticalAlignment="Top" Margin="12,0,0,0" />
                        </Grid>
                        <Border x:Name="PreviewCard" MinHeight="220" Padding="24,20"
                                CornerRadius="4" BorderThickness="1">
                            <TextBlock x:Name="PreviewText" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Classes="cshCard">
                    <StackPanel>
                        <TextBlock Text="字体" FontSize="13" FontWeight="Bold" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="字号" FontSize="12.5" />
                                <TextBlock FontSize="11.5" Opacity="0.65" TextWrapping="Wrap"
                                           Text="悬浮窗和全屏使用的真实字号，范围 12–300。" />
                            </StackPanel>
                            <!-- ⚠️ NumberBox 的 ValueChanged 一律在 code-behind 里挂（本仓库既有约定：
                                 事件在构造之后再接，避免 XAML 解析期就回调到还没建好的控件）。 -->
                            <fa:NumberBox x:Name="FontSizeBox" Grid.Column="1" Margin="12,0,0,0" Width="150"
                                          Value="48" Minimum="12" Maximum="300" SmallChange="2"
                                          SpinButtonPlacementMode="Compact" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="加粗" FontSize="12.5" />
                                <TextBlock FontSize="11.5" Opacity="0.65" TextWrapping="Wrap"
                                           Text="更粗的字重，远看更醒目。" />
                            </StackPanel>
                            <ToggleSwitch x:Name="BoldBox" Grid.Column="1" Margin="12,0,0,0"
                                          OnContent="开" OffContent="关" MinWidth="0"
                                          VerticalAlignment="Center" IsCheckedChanged="Bold_Changed" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="全屏放大" FontSize="12.5" />
                                <TextBlock FontSize="11.5" Opacity="0.65" TextWrapping="Wrap"
                                           Text="全屏展示时字号 × 这个倍数，再按屏幕大小兜一次上限。只影响全屏。" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                        VerticalAlignment="Center" Margin="12,0,0,0">
                                <Slider x:Name="ScaleSlider" Width="200" Minimum="1" Maximum="6"
                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                        ValueChanged="Scale_Changed" />
                                <TextBlock x:Name="ScaleLabel" MinWidth="44" FontSize="12" Opacity="0.7"
                                           VerticalAlignment="Center" Text="3 倍" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="cshCard">
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="文字颜色" FontSize="13" FontWeight="Bold" />
                            <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                       Text="点选常用色，或直接粘贴自定义颜色（#AARRGGBB）。" />
                        </StackPanel>
                        <WrapPanel x:Name="TextColorHost" Margin="0,4,0,0" />
                        <TextBox x:Name="TextColorHex" FontSize="12.5"
                                 Watermark="#FF1F1F1F（可粘贴自定义颜色）"
                                 TextChanged="TextColorHex_Changed" />
                    </StackPanel>
                </Border>

                <Border Classes="cshCard">
                    <StackPanel>
                        <TextBlock Text="背景底色" FontSize="13" FontWeight="Bold" />
                        <TextBlock Margin="0,2,0,0" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                   Text="悬浮窗与预览的底色；点选常用色，或粘贴 #AARRGGBB。全屏展示固定铺满主题底色。" />
                        <WrapPanel x:Name="BackColorHost" Margin="0,10,0,0" />
                        <TextBox x:Name="BackColorHex" Margin="0,0,0,0" FontSize="12.5"
                                 Watermark="#FFFDFDF7（可粘贴自定义颜色）"
                                 TextChanged="BackColorHex_Changed" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="悬浮窗无底色（透明）" FontSize="12.5" />
                                <TextBlock FontSize="11.5" Opacity="0.65" TextWrapping="Wrap"
                                           Text="只对桌面悬浮窗生效。系统不支持真正的透明时，改为整窗半透明（文字也会跟着变淡）。" />
                            </StackPanel>
                            <ToggleSwitch x:Name="TransparentBox" Grid.Column="1" Margin="12,0,0,0"
                                          OnContent="开" OffContent="关" MinWidth="0"
                                          VerticalAlignment="Center" IsCheckedChanged="Transparent_Changed" />
                        </Grid>

                        <TextBlock Margin="0,10,0,0" FontSize="11.5" Opacity="0.55" TextWrapping="Wrap"
                                   Text="提示：真正的「透明」需要系统合成支持。Win7 等系统上会退化为整窗半透明——桌面能透出来，但文字与底色一起变淡。" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="Toast" Grid.Row="2" Margin="0,8,0,0" FontSize="12" Opacity="0.75" />
    </Grid>
</platform:PageBase>
