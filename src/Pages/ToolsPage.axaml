<platform:PageBase
    x:Class="ClassSoftwareHub.Desktop.Pages.ToolsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platform="using:ClassSoftwareHub.Desktop.Platform"
    xmlns:fa="using:FluentAvalonia.UI.Controls">

    <!--
      和首页 / 设置页 / 实验性功能页同一套版式：ScrollViewer 在最外层（滚动条贴窗口最右），
      内容钉在中间 960 宽。

      ✅ 2026-10-18 自上游 1.2.0 移植：卡片整段改成**照搬首页「快速开始」那套**（Nick：「直接复用首页卡片」）：
         · 外观 = cshNavCard（圆角 8 / Padding 14,18），标题 14 不加粗、
           说明 12 / Opacity 0.78、右端 E8A7 指示符 —— 与首页逐项一致；
         · 板式 = 左右两个 ItemsControl 各占一列（首页也是手写两列），
           卡片宽度天然跟着列宽走 ⇒ 窗口再窄也是两列，不会掉成单列、右边留一大片空。
      ⛔ 2026-10-02 否掉的是「卡片随窗口拉伸**铺满整页**」（= 放开 960 上限）—— 那个规矩没变。
    -->
    <platform:PageBase.Resources>
        <!-- 首页「快速开始」那张卡：左右两列共用同一个模板 -->
        <DataTemplate x:Key="NavCardTemplate">
            <Border Classes="cshNavCard"
                    PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                    Tapped="Card_Tapped">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <fa:FontIcon Glyph="{Binding Glyph}" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Desc}" FontSize="12" Opacity="0.78"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <fa:FontIcon Grid.Column="2" Margin="16,0,0,0" Glyph="&#xE8A7;" FontSize="12"
                                 VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </platform:PageBase.Resources>

    <ScrollViewer Padding="24,36,24,44" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
        <Grid MaxWidth="960" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="内置工具" FontSize="30" FontWeight="Bold" />

            <!-- 两列（首页「快速开始」同款：列间距 8、行间距 8）：
                 序号偶数的进左列、奇数的进右列，见 code-behind。 -->
            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ItemsControl x:Name="CardColumnLeft" Grid.Column="0"
                              ItemTemplate="{StaticResource NavCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ItemsControl x:Name="CardColumnRight" Grid.Column="1" Margin="8,0,0,0"
                              ItemTemplate="{StaticResource NavCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>

            <!-- ===== 常用工具窗口：开关就放这儿，跟首页「体验网页版」那张卡一个意思 ===== -->
            <Border Grid.Row="2" CornerRadius="4" Padding="20,16" Margin="0,20,0,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <!-- 原版 ColumnSpacing=16 / RowSpacing=12 → 用 Margin 模拟 -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <fa:FontIcon Glyph="&#xE71D;" FontSize="20" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="3">
                        <TextBlock Text="常用工具窗口" FontSize="15" FontWeight="Bold" />
                        <TextBlock FontSize="12.5" Opacity="0.7" TextWrapping="Wrap"
                                   Text="置顶小窗口，仅包含四项常用工具：随机抽号、课堂计时、秒表计时、全屏时钟。无需打开主界面：系统托盘提供独立图标，单击即可显示（窗口可拖动，按 Esc 收起）。屏幕边缘另提供「侧边栏」入口，全屏播放 PPT 时仍可单击。" />
                        <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                   Text="侧边栏、窗口置顶等开关位于「设置 → 常用工具」中。" />
                    </StackPanel>
                    <Button Grid.Column="2" Margin="16,0,0,0" Content="打开窗口" Classes="accent"
                            VerticalAlignment="Top" Click="OpenPalette_Click" />

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" Orientation="Horizontal" Spacing="28">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="关闭时收进系统托盘" FontSize="13" VerticalAlignment="Center" />
                            <!-- ⚠️ 原版是 WinUI ToggleSwitch 的 IsOn + Toggled 事件；
                                 Avalonia 的 ToggleSwitch 用 IsChecked + IsCheckedChanged，语义一致。 -->
                            <ToggleSwitch x:Name="TraySwitch" OnContent="开" OffContent="关" MinWidth="0"
                                          IsCheckedChanged="TraySwitch_Toggled" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</platform:PageBase>
