<platform:PageBase
    x:Class="ClassSoftwareHub.Desktop.Pages.ChangelogPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platform="using:ClassSoftwareHub.Desktop.Platform"
    xmlns:fa="using:FluentAvalonia.UI.Controls">

    <!--
      ⛔⛔ 版式要点（2026-10-18 自上游 1.2.0 移植，Nick 的七条意见）：
      1. 顶部那张「巨无霸版本卡」删了 —— 版本号 + 通道 + 数据来源压成标题下方一行副标题。
      2. 操作栏不再左右分家：筛选、刷新、在浏览器打开全收进左栏列表正上方，
         它们控制的就是这个列表，主次关系一目了然。单选按钮换成下拉（不用 RadioButton 占版面）。
      3. 左侧列表用**原生 ListBox**（系统自带的选中高亮、悬停、键盘导航），
         条目是「主标题（版本号）+ 副标题（日期 · 通道）」两行文本，不自绘选中底色。
      4. 右侧正文按 Markdown 的标题**分组**，组标题 15.5 SemiBold、组间留白，
         版本之间用分隔线而不是层层卡片 —— 像读文档，不是往灰盒子里塞记事本。
      ⚠️ 移植适配：WinUI 的 Grid ColumnSpacing/RowSpacing → 列间边距；
         Visibility → IsVisible；IsTextSelectionEnabled → SelectableTextBlock；
         ListView → ListBox；ChangeView → 设 ScrollViewer.Offset。
    -->
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" MaxWidth="960" Margin="0,36,0,44">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== 标题区（原来那张大卡的信息压缩成一行） ===== -->
            <StackPanel Spacing="5">
                <TextBlock Text="更新日志" FontSize="28" FontWeight="Bold" />
                <SelectableTextBlock x:Name="HeaderMeta" FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="264" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== 左栏：工具栏 + 版本列表 + 计数 ===== -->
                <Border Classes="cshCard" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 工具栏：筛选在左，两个图标操作靠右，全部属于「这个列表」 -->
                        <Grid Margin="12,12,12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- ⚠️ 必须给 SelectedIndex：不给的话框里是空的，看着像坏了 -->
                            <ComboBox x:Name="FilterBox" SelectedIndex="0" HorizontalAlignment="Stretch"
                                      SelectionChanged="Filter_Changed"
                                      ToolTip.Tip="按发布通道筛选">
                                <ComboBoxItem Content="全部版本" />
                                <ComboBoxItem Content="仅正式版本" />
                            </ComboBox>

                            <Button Grid.Column="1" Margin="6,0,0,0" Padding="8,6"
                                    Click="Refresh_Click" ToolTip.Tip="重新读取发布说明">
                                <fa:FontIcon Glyph="&#xE72C;" FontSize="13" />
                            </Button>

                            <Button Grid.Column="2" Margin="6,0,0,0" Padding="8,6"
                                    Click="OpenWeb_Click" ToolTip.Tip="在浏览器中查看全部发布">
                                <fa:FontIcon Glyph="&#xE8A7;" FontSize="13" />
                            </Button>
                        </Grid>

                        <!-- 原生 ListBox：选中/悬停/键盘导航全交给系统默认视觉，不自绘 -->
                        <ListBox x:Name="VersionList" Grid.Row="1" SelectionMode="Single"
                                 Margin="0,0,0,4" Padding="4,0,4,0"
                                 SelectionChanged="VersionList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="1" Margin="0,3,0,3">
                                        <TextBlock Text="{Binding Tag}" FontSize="13.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SubLine}" FontSize="11.5"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="StateText" Grid.Row="2" FontSize="11.5" Opacity="0.55"
                                   Margin="14,6,14,12" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <!-- ===== 右栏：文档式正文（不套大边框） ===== -->
                <Grid Grid.Column="1" Margin="24,0,0,0">
                    <ScrollViewer x:Name="ReleaseScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="2,0,10,0" Background="Transparent">
                        <ItemsControl x:Name="ReleaseList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="0" Margin="0,0,0,26">
                                        <!-- 版本头：版本号 + 通道徽标 + 右对齐日期 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Tag}" FontSize="19" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />

                                            <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="9" Padding="7,1"
                                                    VerticalAlignment="Center"
                                                    BorderThickness="1"
                                                    BorderBrush="{Binding BadgeBrush}">
                                                <TextBlock Text="{Binding ChannelText}" FontSize="11"
                                                           Foreground="{Binding BadgeBrush}" />
                                            </Border>

                                            <TextBlock Grid.Column="2" Text="{Binding DateText}" FontSize="11.5"
                                                       Opacity="0.5" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <Border Height="1" Margin="0,10,0,14"
                                                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                                        <!-- 按 Markdown 标题分组：组标题 + 组内条目 -->
                                        <ItemsControl ItemsSource="{Binding Blocks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Spacing="5" Margin="{Binding Margin}">
                                                        <TextBlock Text="{Binding Title}" FontSize="15.5"
                                                                   FontWeight="SemiBold"
                                                                   IsVisible="{Binding TitleVisible}"
                                                                   TextWrapping="Wrap" />
                                                        <ItemsControl ItemsSource="{Binding Lines}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="14" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <TextBlock Text="•" FontSize="13"
                                                                                   Opacity="0.45"
                                                                                   IsVisible="{Binding IsBullet}"
                                                                                   VerticalAlignment="Top" />

                                                                        <SelectableTextBlock Grid.Column="1"
                                                                                   Text="{Binding Text}"
                                                                                   FontSize="13" LineHeight="21"
                                                                                   TextWrapping="Wrap"
                                                                                   Opacity="{Binding Opacity}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel x:Name="LoadingPanel" Spacing="12" HorizontalAlignment="Center"
                                VerticalAlignment="Center" IsVisible="False">
                        <fa:ProgressRing x:Name="LoadingRing" IsActive="True" Width="34" Height="34"
                                         HorizontalAlignment="Center" />
                        <TextBlock Text="正在从更新仓库读取发布说明。" FontSize="12" Opacity="0.7"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="FallbackPanel" Spacing="10" IsVisible="False"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <fa:FontIcon Glyph="&#xE81C;" FontSize="32" Opacity="0.45" HorizontalAlignment="Center" />
                        <TextBlock x:Name="FallbackText" MaxWidth="420" TextAlignment="Center"
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</platform:PageBase>
