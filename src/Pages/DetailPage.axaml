<platform:PageBase
    x:Class="ClassSoftwareHub.Desktop.Pages.DetailPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platform="using:ClassSoftwareHub.Desktop.Platform"
    xmlns:fa="using:FluentAvalonia.UI.Controls"
    xmlns:data="using:ClassSoftwareHub.Desktop.Data">

    <!--
      ⛔⛔ 版式照 Microsoft Store（2026-10-18 自上游 1.2.0 移植，Nick 2026-10-17 二次定稿）：
      · 顶部色带**满宽铺到内容区边缘**、竖直渐变、下缘化到透明（没有可见的边），内文锁 960 与正文对齐；
      · 色带上只留 图标 / 名称 / 标语 / 分类与版本，⛔ 不放下载按钮（下方有完整的下载通道列表）；
      · 正文与右栏各自成块，段落之间留足空白 —— 上一版所有间距都紧贴，被指"拥挤"。
      色带颜色由 Services/IconPalette 取自图标，取不到退回主题强调色。
      ⚠️ 移植适配：ColumnSpacing → 列间 Margin；Visibility → IsVisible；
         InfoBar 的 IsOpen=false 仍会占高度 → 显式 IsVisible 控制；
         x:Bind → {Binding}。
    -->
    <Grid Background="Transparent">
        <!-- ⛔⛔ HorizontalContentAlignment 必须写 Stretch：
             ScrollViewer 默认让内容按"自身想要的大小"摆放，于是整块被压窄、左右边距一大一小，
             色带也铺不满（实测右侧凭空多出 130px 空白）。 -->
        <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ===== 色带底：满宽、贴顶、竖直渐变 ===== -->
                <Border x:Name="Hero" Grid.Row="0" Opacity="0" />

                <!-- ===== 色带内文：与正文同宽（960）===== -->
                <!-- ⛔ HorizontalAlignment 必须是 Stretch：写 Center 时 Grid 会缩到"内容宽度"再居中，
                     结果是图标比正文明明偏右一大截（踩过）。Stretch + MaxWidth 才会满 960 居中。 -->
                <Grid Grid.Row="0" MaxWidth="960" Margin="24,56,24,50" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 圆角 + 1:1 居中裁剪：固定 92×92 正方形。
                         ⚠️ 原版用 ImageBrush 填满（Border 不裁剪子元素）；本移植版用
                            Border(ClipToBounds) + Image(UniformToFill) 还原同样的"从正中间裁圆角"。 -->
                    <Border x:Name="IconBox" Width="92" Height="92" CornerRadius="18" ClipToBounds="True"
                            VerticalAlignment="Top" HorizontalAlignment="Left">
                        <Grid>
                            <Image x:Name="IconImage" Stretch="UniformToFill" />
                            <!-- 图标没下来时的兜底：彩色底 + 名字首字（2026-10-02，替代原来的灰购物袋字形） -->
                            <Border x:Name="IconFallback" IsVisible="False">
                                <TextBlock x:Name="IconFallbackText" Text="?" FontSize="38" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="24,0,0,0" Spacing="13" VerticalAlignment="Top">
                        <TextBlock x:Name="AppName" FontSize="32" FontWeight="Bold"
                                   LineHeight="40" TextWrapping="Wrap" />
                        <TextBlock x:Name="AppTagline" FontSize="14.5" Opacity="0.82"
                                   LineHeight="21" TextWrapping="Wrap" />

                        <!-- 分类徽标 + 版本·体积·系统，压成一行，不再各占一行 -->
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                            <Border x:Name="CategoryBadge" CornerRadius="10" Padding="9,3"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <TextBlock x:Name="CategoryText" FontSize="11.5" Opacity="0.9" />
                            </Border>
                            <TextBlock x:Name="HeroMeta" FontSize="12" Opacity="0.62"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ===== 正文两栏 ===== -->
                <Grid x:Name="BodyGrid" Grid.Row="1" MaxWidth="960" Margin="24,44,24,68"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="320" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <!-- 小提示（数据里 notice 字段）。⛔ 默认隐藏：
                             关着的 InfoBar 仍会占掉一排高度（约 32px），把「应用介绍」压低、
                             跟右栏的「推荐应用」错开一大截。 -->
                        <fa:InfoBar x:Name="NoticeBar" Severity="Informational" IsOpen="False"
                                    IsClosable="False" IsVisible="False" Margin="0,0,0,26" />

                        <!-- 应用介绍 -->
                        <TextBlock x:Name="IntroTitle" FontSize="17" FontWeight="SemiBold"
                                   Margin="0,0,0,14" />
                        <TextBlock x:Name="AppDescription" TextWrapping="Wrap" FontSize="14"
                                   LineHeight="27" Opacity="0.88" />

                        <!-- 详细信息 -->
                        <TextBlock x:Name="InfoTitle" FontSize="17" FontWeight="SemiBold"
                                   Margin="0,54,0,6" />
                        <!-- ⛔ 不再套灰色卡片（Nick：灰底很丑）。改成细分割线的纯文字行，跟商店的详情区做法一致。 -->
                        <StackPanel x:Name="InfoList" Margin="0,6,0,0" />

                        <!-- 下载通道 -->
                        <TextBlock x:Name="DownloadsTitle" FontSize="17" FontWeight="SemiBold"
                                   Margin="0,54,0,6" />

                        <!--
                          应用商店入口（2026-10-19 改版，1:1 对齐上游 1.3）：加微软商店图标 + 白底「获取」按钮。
                          ⚠️ 原来只是一块纯色 + 两行字 + 透明按钮，没有任何商店标识，用户看不出这是商店通道。
                          ⚠️ 原版 ColumnSpacing=14 → 第 2、3 列加 14 左 Margin。
                          ⚠️ TODO(win7): 商店图标（Assets/StoreLogo.png）还没进本仓库的内嵌资源 ——
                             仓库根 Assets 里目前没有这张图。代码里已按「有就显示、没有就收起」处理（见 LoadStoreLogo），
                             Lead 把上游 C:\csh-up-130\Assets\StoreLogo.png 拷到仓库根 Assets\ 后即自动生效
                             （csproj 的 AvaloniaResource Include="..\Assets\**\*.png" 已覆盖）。
                        -->
                        <Border x:Name="StoreCard" IsVisible="False" CornerRadius="8" Padding="18,16"
                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 微软商店 Logo（取不到时收起，卡片照样能用） -->
                                <Image x:Name="StoreLogo" Width="40" Height="40" IsVisible="False"
                                       VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock x:Name="StoreTitle" FontSize="16" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="StoreDesc" FontSize="12.5" TextWrapping="Wrap" Opacity="0.9"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </StackPanel>

                                <Button x:Name="StoreButton" Grid.Column="2" Margin="14,0,0,0"
                                        VerticalAlignment="Center"
                                        Click="Store_Click"
                                        Background="White" Foreground="#1B1B1B"
                                        BorderThickness="0" Padding="20,7" CornerRadius="4"
                                        FontSize="13.5" FontWeight="SemiBold" />
                            </Grid>
                        </Border>

                        <TextBlock x:Name="StoreOnlyHint" IsVisible="False" FontSize="12.5" Opacity="0.7"
                                   Margin="0,12,0,0" TextWrapping="Wrap" />

                        <!-- 下载项：平台 / 备注 / 体积 / 类型说明（仅跳转类）+ 校验值 + 主按钮 + 加速下载 -->
                        <ItemsControl x:Name="DownloadList" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- ⛔ 不再用灰色卡片包一层：改成"行 + 底部细分割线"，靠留白分组。 -->
                                    <Border Padding="0,22" Margin="0,0,0,2"
                                            BorderThickness="0,0,0,1"
                                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="6">
                                                <!-- 平台名与体积同一行（体积跟在名字后面），少一行就少一分松散 -->
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding Platform}" FontSize="14"
                                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Size}" FontSize="12.5" Opacity="0.55"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Note}" FontSize="12.5" Opacity="0.65"
                                                           TextWrapping="Wrap" />
                                                <!-- 跳转类（网盘 / 官网下载页）才有的一行说明；文件直链整行收起。 -->
                                                <TextBlock Text="{Binding KindHint}"
                                                           IsVisible="{Binding KindHintVisibility}"
                                                           FontSize="12" Opacity="0.7"
                                                           TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="8"
                                                            HorizontalAlignment="Left" Margin="0,4,0,0">
                                                    <Button Content="{Binding HashChipText}" Tag="{Binding Hash}"
                                                            IsVisible="{Binding HashVisibility}"
                                                            Click="CopyHash_Click"
                                                            Padding="8,3" FontSize="11.5" Opacity="0.9"
                                                            ToolTip.Tip="{Binding Hash}" />
                                                    <Button Tag="{Binding Hash}" IsVisible="{Binding HashVisibility}"
                                                            Click="HashCheck_Click"
                                                            Padding="8,3" FontSize="11.5" Opacity="0.9"
                                                            ToolTip.Tip="在「编码 / 哈希工具」中核对该校验值：选择下载的安装包后自动比对">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <fa:FontIcon Glyph="&#xE73E;" FontSize="11" />
                                                            <TextBlock Text="校验" FontSize="11.5" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="20,0,0,0" Orientation="Horizontal" Spacing="8"
                                                        VerticalAlignment="Center">
                                                <!-- 文案随链接类型变：直链写「下载」，网盘写「前往网盘」、
                                                     官网下载页写「前往官网」（Data/DownloadLinkKind.cs） -->
                                                <Button Content="{Binding ActionText}" Tag="{Binding Url}"
                                                        Classes="accent"
                                                        Click="Download_Click" />
                                                <Button Tag="{Binding Url}" Click="Mirror_Click"
                                                        IsVisible="{Binding MirrorVisibility}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <fa:FontIcon Glyph="&#xE945;" FontSize="12" />
                                                        <TextBlock Text="加速下载" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 数据问题（该软件的 JSON 有问题时会提示） -->
                        <fa:InfoBar x:Name="IssueBar" Severity="Warning" IsOpen="False" IsClosable="False"
                                    Margin="0,18,0,0" />
                    </StackPanel>

                    <!-- ===== 右栏：推荐应用 ===== -->
                    <StackPanel x:Name="Rail" Grid.Column="1" Margin="40,0,0,0">
                        <TextBlock Text="推荐应用" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16" />

                        <ItemsControl x:Name="RecommendList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 名称 + **短简介**（不再用分类：Nick 2026-10-17 指定）。
                                         简介优先 Tagline、退 Description，最多两行。 -->
                                    <Button Click="Recommend_Click" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent" BorderThickness="0"
                                            Padding="0" MinHeight="0" CornerRadius="6">
                                        <Grid Margin="8,13,8,13">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="44" Height="44" CornerRadius="10" ClipToBounds="True"
                                                    Background="{Binding IconBrush}">
                                                <!-- ⛔ 购物袋只是「没有图标/还没加载完」的占位，
                                                     图标一旦加载成功必须收起（绑 IconPlaceholder），
                                                     否则会叠在真图标中间。 -->
                                                <fa:FontIcon Glyph="&#xE7B8;" FontSize="17" Opacity="0.35"
                                                             IsVisible="{Binding IconPlaceholder}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="3"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" MaxLines="2"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding IntroText}" FontSize="11.5"
                                                           Opacity="0.55"
                                                           TextWrapping="Wrap" MaxLines="2"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="RailEmpty" IsVisible="False" FontSize="12" Opacity="0.55"
                                   TextWrapping="Wrap" Text="暂无推荐应用。" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</platform:PageBase>
