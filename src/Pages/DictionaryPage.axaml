<platform:PageBase
    x:Class="ClassSoftwareHub.Desktop.Pages.DictionaryPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platform="using:ClassSoftwareHub.Desktop.Platform"
    xmlns:controls="using:ClassSoftwareHub.Desktop.Controls"
    xmlns:fa="using:FluentAvalonia.UI.Controls">

    <!--
      查阅单词（自上游 dv1.2.0-insider1.8 移植，需求清单第 17 条）。

      版式照母版 Pages/AutoShutdownPage.xaml：三列 Grid 把内容钉在中间 960 宽。

      **查单词与翻译句子是两张独立的卡，各用各的输入框**（上游 2026-11-01 Nick 定：
      不要一个框又查词又翻句）。理由：查词是敲几个字母看候选，翻译是粘一整段句子；
      挤在一个框里，补全列表在翻译时纯属碍事。

      每张卡自己成一体：标题 → 输入 → 结果，结果与输入之间用一条淡分隔线断开。
      结果一律在代码里逐条构造，⛔ 不用 ItemTemplate + x:Bind。

      ⚠️ 移植说明（WinUI → Avalonia）：
        · AutoSuggestBox 在 Avalonia/FA 里没有 → TextBox + 内联 ListBox 候选（同一张卡内、
          不弹层，避开了 Popup 在 Win7 深色主题下露白边那个坑）。点击/回车/上下键都能选。
        · IsTextSelectionEnabled → SelectableTextBlock。
        · HyperlinkButton 不存在 → 透明底 + 强调色前景的 Button。
        · Clipboard → TopLevel.Clipboard（见 code-behind）。
    -->
    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,36,24,44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" MaxWidth="960" Spacing="4">

                    <!-- ═════════ 页头 ═════════ -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="查阅单词" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />

                        <Button Grid.Column="1" Padding="12,6" Click="HubAiEntry_Click"
                                VerticalAlignment="Center" ToolTip.Tip="打开 Hub AI 顾问">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fa:FontIcon Glyph="&#xE8F2;" FontSize="13" />
                                <TextBlock Text="AI" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- ═════════ 一、查单词 ═════════ -->
                    <Border Classes="cshCard" Padding="16,14">
                        <StackPanel Spacing="12">

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <fa:FontIcon Glyph="&#xE8F1;" FontSize="13.5" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock Text="查单词" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- 输入 + 内联候选（替代 AutoSuggestBox） -->
                            <TextBox x:Name="WordBox" FontSize="14"
                                     Watermark="输入英文单词，边打边选"
                                     TextChanged="WordBox_TextChanged"
                                     KeyDown="WordBox_KeyDown" />

                            <ListBox x:Name="SuggestList" MaxHeight="168" IsVisible="False"
                                     SelectionMode="Single" Padding="0"
                                     SelectionChanged="SuggestList_SelectionChanged">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="10,4" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.Styles>
                            </ListBox>

                            <fa:InfoBar x:Name="WordNotice" IsOpen="False" IsVisible="False" IsClosable="False"
                                        Severity="Informational" Message="" />

                            <!-- 空状态：还没查过词时摆几个示例 -->
                            <StackPanel x:Name="WordEmpty" Spacing="8" Margin="0,6,0,2">
                                <TextBlock Text="先查本地词库，没收录的再联网查" FontSize="12" Opacity="0.45" />
                                <StackPanel x:Name="SamplePanel" Orientation="Horizontal" Spacing="8" />
                            </StackPanel>

                            <!-- 词条 -->
                            <StackPanel x:Name="WordBlock" Spacing="12" IsVisible="False">

                                <Border Height="1" Opacity="0.08"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock x:Name="WordText" FontSize="25" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />

                                        <Button x:Name="SpeakButton" Padding="6,4" Margin="2,4,0,0"
                                                VerticalAlignment="Center" Click="Speak_Click"
                                                ToolTip.Tip="朗读这个单词">
                                            <fa:FontIcon Glyph="&#xE767;" FontSize="13" />
                                        </Button>

                                        <TextBlock x:Name="PhoneticText" FontSize="13" Opacity="0.58"
                                                   VerticalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Top">
                                        <Border CornerRadius="4" Padding="8,3" VerticalAlignment="Center"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <TextBlock x:Name="WordSource" FontSize="11.5" Opacity="0.7" />
                                        </Border>

                                        <Button Padding="8,4" Click="CopyWord_Click"
                                                ToolTip.Tip="复制这一条的完整解释">
                                            <fa:FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="SensePanel" Spacing="10" />

                                <StackPanel x:Name="ExampleBlock" Spacing="8" IsVisible="False">
                                    <TextBlock Text="例句" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
                                    <StackPanel x:Name="ExamplePanel" Spacing="10" />
                                </StackPanel>

                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- ═════════ 二、翻译句子 ═════════ -->
                    <Border Classes="cshCard" Padding="16,14" Margin="0,14,0,0">
                        <StackPanel Spacing="12">

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <fa:FontIcon Glyph="&#xE8AC;" FontSize="13.5" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock Text="翻译句子" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- 多行输入：用控件自带的边框，跟上面那个输入框同一视觉语言 -->
                            <TextBox x:Name="SentenceBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     FontSize="14" MinHeight="84" MaxHeight="150"
                                     Watermark="粘贴或输入一段话，中文英文都可以" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="DirectionHint" Text="自动识别方向" FontSize="12" Opacity="0.45"
                                           VerticalAlignment="Center" />

                                <Button x:Name="TranslateButton" Grid.Column="1" Content="翻译"
                                        Theme="{StaticResource AccentButtonStyle}"
                                        Padding="24,7" Click="Translate_Click" />
                            </Grid>

                            <fa:InfoBar x:Name="TransNotice" IsOpen="False" IsVisible="False" IsClosable="False"
                                        Severity="Informational" Message="" />

                            <StackPanel x:Name="TransBlock" Spacing="10" IsVisible="False">

                                <Border Height="1" Opacity="0.08"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="TransDirection" FontSize="12.5" FontWeight="SemiBold"
                                               Opacity="0.75" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <Border CornerRadius="4" Padding="8,3"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <TextBlock x:Name="TransProvider" FontSize="11.5" Opacity="0.7" />
                                        </Border>

                                        <Button Padding="8,4" Click="CopyTranslation_Click"
                                                ToolTip.Tip="复制译文">
                                            <fa:FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <SelectableTextBlock x:Name="TransTarget" FontSize="18" LineHeight="26"
                                                     TextWrapping="Wrap" />

                                <StackPanel Spacing="2">
                                    <TextBlock Text="原文" FontSize="11" Opacity="0.4" />
                                    <SelectableTextBlock x:Name="TransSource" FontSize="12.5" Opacity="0.6"
                                                         TextWrapping="Wrap" />
                                </StackPanel>

                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- ═════════ 最近查过的词 ═════════ -->
                    <StackPanel x:Name="HistoryBlock" Spacing="2" Margin="2,20,2,0" IsVisible="False">
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="最近查过的词" FontSize="12.5" FontWeight="SemiBold" Opacity="0.7"
                                       VerticalAlignment="Center" />
                            <Button Content="清空" FontSize="12" Padding="6,0,0,0"
                                    HorizontalAlignment="Right"
                                    Background="Transparent" BorderThickness="0" Opacity="0.6"
                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                    Click="ClearHistory_Click" />
                        </Grid>
                        <StackPanel x:Name="HistoryPanel" Spacing="0" />
                    </StackPanel>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <controls:HubAiFlyout x:Name="AiFlyout" />
    </Grid>
</platform:PageBase>
