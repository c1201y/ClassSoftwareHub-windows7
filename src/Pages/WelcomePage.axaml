<platform:PageBase
    x:Class="ClassSoftwareHub.Desktop.Pages.WelcomePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platform="using:ClassSoftwareHub.Desktop.Platform"
    xmlns:fa="using:FluentAvalonia.UI.Controls"
    xmlns:core="using:ClassSoftwareHub.Desktop.Core">

    <!--
      ⚠️ 移植说明（自上游 dv1.1.2 首页改版，WinUI → Avalonia/FluentAvalonia）：
      · Page.Resources → PageBase.Resources；InfoBar → fa:InfoBar；ThemeResource → DynamicResource。
      · 卡片悬停反馈：原版 PointerEntered/PointerExited 改 Opacity → Avalonia 用 :pointerover 伪类（行为一致）。
      · Avalonia 的 Grid 没有 ColumnSpacing / RowSpacing：原版的列间距一律用
        「第 2 列起每个子元素加左 Margin」模拟（下同，改动布局前先看这条）。
      · 本页卡片圆角为 8（对齐上游首页改版）；其他页面的 cshCard 仍是 4，不要混淆。
    -->
    <platform:PageBase.Styles>
        <Style Selector="Border.card:pointerover">
            <Setter Property="Opacity" Value="0.88" />
        </Style>
    </platform:PageBase.Styles>

    <platform:PageBase.Resources>
        <!--
          快捷入口模板：五颗共用一套外观，不带主题色底；
          图标优先用按主题色染过的 SVG（QuickLink.IconSource），没有 SVG 的项退回 FontIcon。
          颜色全走 {DynamicResource}（它认识"这棵树"的主题，浅色/深色自己会变）。
        -->
        <DataTemplate x:Key="QuickLinkNormal">
            <!-- Background="Transparent" 必须有：没 Background 的 Border 不参与命中测试，
                 点卡片空白处会穿透。 -->
            <Border CornerRadius="4" Padding="12,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="Transparent">
                <StackPanel Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="24" Height="24" HorizontalAlignment="Center">
                        <fa:FontIcon Glyph="{Binding Glyph}" FontSize="24" HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.95"
                                     IsVisible="{Binding ShowGlyph}" />
                        <Image Source="{Binding IconSource}" Width="24" Height="24" Stretch="Uniform"
                               IsVisible="{Binding HasIconSource}" />
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontSize="13" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <core:QuickLinkSelector x:Key="QuickLinkSelector"
                                Normal="{StaticResource QuickLinkNormal}" />
    </platform:PageBase.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!--
          别用 Stretch + MaxWidth：触发上限时整列会右甩（左边空一大块）而变形。
          这里用「三列 Grid：* / 960 / *」把内容钉在中间 960 宽，导航展开或收起都不动。
        -->
        <Grid Margin="24,36,24,44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="998*" MaxWidth="960" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Spacing="8">

            <!-- 首页大标题：字号 24；副名用英文「- Desktop」（与站点/仓库口径一致）。
                 站点名副标题行（HomeTitleText）已整行删除：大标题已写明 Desktop，
                 下面再挂一行站点名纯属重复，不要补回；
                 「已收录 XX 款软件」也不要放这行底下 —— 已整行挪进设置卡片下面的 CollectedBar。 -->
            <TextBlock Text="ClassSoftwareHub - Desktop" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />

            <!-- ===== 公告（2026-11-05，自上游 1.10 移植）=====
                 Nick：「之后的版本中如果有公告的话，应用软件首页顶部显示 infobar，每个版本可控，可以显示多条」。
                 位置就在大标题正下方 —— 进首页第一眼就能看到，又不至于抢大标题。
                 ⚠️ 条目在 code-behind 的 RenderNotices() 里生成（每条一个 InfoBar），这里只留容器。
                    没有公告时容器高度为 0，不占任何间距，也不影响下面那块 banner 的位置。 -->
            <StackPanel x:Name="NoticeHost" Spacing="8" />

            <!-- 图片（高 140，宽按比例，圆角 12）+ 版本号（图片右侧·左上）+ 代号（图片右侧·右上）
                 Grid 没有 ColumnSpacing=20 → 第 1 列子元素的左 Margin=20 模拟 -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border CornerRadius="12" BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <Image x:Name="Banner" Height="140" Stretch="Uniform" />
                </Border>

                <!-- 版本号 + 应用代号：**上下两行、都靠左**（2026-11-08 对齐上游 dv1.2.0）。
                     ⛔ 此前本移植版把代号贴到右端、和版本号各占一头 —— 那是早期做法，
                        上游 2026-10-17 已改成上下两行。代号是版本号的附属信息，分居屏幕两端
                        读起来像两个不相关的数据，窄窗口下还会顶到一起。 -->
                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top" Spacing="2" HorizontalAlignment="Left">
                    <!-- 只显示软件自己的版本；"网站版本"行已删：软件是独立发布物，
                         不作为网站版本的附属品展示。 -->
                    <TextBlock x:Name="ShellVersionText" FontSize="28" FontWeight="Bold" />
                    <!-- 应用代号：只显示英文代号本身，不加「代号」等中文前缀。 -->
                    <TextBlock x:Name="CodeNameText" Text="Synesthesia" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- 顶部独立的「更新状态卡片」已并入下方快速开始的主题色卡，
                 版本状态文案改在「查看更新内容」那张卡上显示。
                 状态逻辑没有删：仍在 code-behind 的 RefreshUpdateCard() 里，
                 目标元素从 InfoBar 换成了 ChangelogCardTitle / ChangelogCardSubtitle。 -->

            <!-- ===== 推荐应用（Store「精选实用软件」样式）=====
                 一排整卡缓慢向左匀速滚动、无缝循环。每张卡是一整块圆角卡：
                 上半 = 图标放大 + 着色底、中央叠圆角清晰图标；下半 = 加粗名称 + 一句短简介。
                 鼠标悬停暂停，点卡片进详情页。位置在「快速开始」标题正上方。
                 卡片在 code-behind 的 BuildRecommendations() 里生成（要复制一份做无缝循环，
                 用不到 DataTemplate）；视口裁剪靠 Clip，见 LayoutRecommend()。
                 AcrylicBrush（实时毛玻璃）Avalonia 没有 → 上半部分改用
                 「图标散列主色 + 一层半透明黑/白罩」做同样的观感。 -->
            <Grid x:Name="RecommendSection" IsVisible="False" Margin="0,22,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="推荐应用" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="换一批" Click="Recommend_Reroll"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Padding="8,2"
                            FontSize="12" Opacity="0.7" />
                </Grid>

                <Border Grid.Row="1" x:Name="RecommendViewport" HorizontalAlignment="Stretch"
                        MaxWidth="960" VerticalAlignment="Top" Background="Transparent"
                        PointerEntered="Recommend_PointerEntered" PointerExited="Recommend_PointerExited">
                    <StackPanel x:Name="RecommendStrip" Orientation="Horizontal" Spacing="12"
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel.RenderTransform>
                            <TranslateTransform />
                        </StackPanel.RenderTransform>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="快速开始" FontSize="20" FontWeight="Bold" Margin="0,20,0,4" />

            <!-- 主题色一行两张：访问网页版 / 查看更新内容（全宽卡对半切开，
                 右半张换成更新日志入口）。两张都跟下面的普通卡片同规格：标题 + 副标题 + 右端指示符。
                 底色与文字色必须成对用 Accent / TextOnAccent 画刷，不写死色值（浅色主题会自动翻深字）。
                 高度只靠 Padding 撑，不写 Height —— 两列同处一个 Grid，天然自动等高。
                 Grid 无 ColumnSpacing=8 → 第 2 列左 Margin=8。 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="WebCard" Grid.Column="0" Classes="card" Tag="web" CornerRadius="8" Padding="16,18"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Tapped="Card_Tapped">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <fa:FontIcon Glyph="&#xE774;" FontSize="20" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        <!-- Grid 无 ColumnSpacing=18 → 第 2、3 列各加 18 左 Margin 模拟 -->
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="访问网页版" FontSize="14"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            <TextBlock Text="在浏览器中打开完整站点" FontSize="12" Opacity="0.78"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </StackPanel>
                        <fa:FontIcon Grid.Column="2" Margin="18,0,0,0" Glyph="&#xE8A7;" FontSize="12" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Grid>
                </Border>

                <!-- 「查看更新内容」：图标口径跟导航栏那条「更新日志」一致（E81C = 时钟/历史）。
                     副标题＝版本状态，原本挂在顶部那张更新卡片上，2026-10-06 随卡片一起并到这里；
                     文案由 code-behind 的 RefreshUpdateCard() 按「待装 / 已是最新」两态填。 -->
                <Border x:Name="ChangelogCard" Grid.Column="1" Margin="8,0,0,0" Classes="card" Tag="changelog"
                        CornerRadius="8" Padding="16,18"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Tapped="ChangelogCard_Tapped">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- 有更新时换对勾 E930 + 绿色横幅，所以要能改字形/颜色 -->
                        <fa:FontIcon x:Name="ChangelogIcon" Glyph="&#xE81C;" FontSize="20" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="ChangelogCardTitle" Text="查看更新内容" FontSize="14"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            <TextBlock x:Name="ChangelogCardSubtitle" FontSize="12" Opacity="0.78"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </StackPanel>
                        <fa:FontIcon x:Name="ChangelogChevron" Grid.Column="2" Margin="18,0,0,0" Glyph="&#xE8A7;" FontSize="12"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        <!-- 待装态：右端指示符让位给「立即安装」 -->
                        <Button x:Name="UpdateInstallButton" Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center"
                                Content="立即安装" IsVisible="False" Click="InstallPending_Click" />
                        <!-- 只是查到新版本（包还没下）：给一颗「立即更新」（2026-10-18 自上游 1.2.0 移植） -->
                        <Button x:Name="UpdateNowButton" Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center"
                                Content="立即更新" IsVisible="False" Click="UpdateNow_Click" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 两张等大卡片（Grid 无 ColumnSpacing=8 → 第 1 列卡片右Margin/第 2 列左 Margin=8；
                 dv1.1.2 起每张卡都有副标题 + 右端 chevron） -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Classes="card" Tag="apps" CornerRadius="8" Padding="14,18"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Tapped="Card_Tapped">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <fa:FontIcon Glyph="&#xE896;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="下载首页" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="浏览并下载常用软件" FontSize="12" Opacity="0.65" />
                        </StackPanel>
                        <fa:FontIcon Grid.Column="2" Margin="16,0,0,0" Glyph="&#xE8A7;" FontSize="12" VerticalAlignment="Center" Opacity="0.7" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Margin="8,0,0,0" Classes="card" Tag="tools" CornerRadius="8" Padding="14,18"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Tapped="Card_Tapped">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <fa:FontIcon Glyph="&#xE71D;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="内置工具" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="常用小工具集合" FontSize="12" Opacity="0.65" />
                        </StackPanel>
                        <fa:FontIcon Grid.Column="2" Margin="16,0,0,0" Glyph="&#xE8A7;" FontSize="12" VerticalAlignment="Center" Opacity="0.7" />
                    </Grid>
                </Border>
            </Grid>

            <!--
              教室喊话 / 函数图像（自上游 1.8 补）：
              这两项在导航栏里是**一级功能项**（喊话是从工具里提出来的，函数图像是 Standalone），
              首页一直没给卡片，用户从首页根本看不到它们。放在第二排 —— 只排在「下载首页」之后，
              其余卡片依次下移。
              标签就是导航用的那个 tag（announce / function-plot），不要另起名字：
                 function-plot 交给 NavigateTagCore 按 Id 反查工具表，才能走载体选择（Web 优先、原生兜底）。
            -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Classes="card" Tag="announce" CornerRadius="8" Padding="14,18"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Tapped="Card_Tapped">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <fa:FontIcon Glyph="&#xE720;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="教室喊话" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="全屏提醒，同网段与远程都能收到" FontSize="12" Opacity="0.65" />
                        </StackPanel>
                        <fa:FontIcon Grid.Column="2" Margin="16,0,0,0" Glyph="&#xE8A7;" FontSize="12" VerticalAlignment="Center" Opacity="0.7" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Margin="8,0,0,0" Classes="card" Tag="function-plot" CornerRadius="8" Padding="14,18"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Tapped="Card_Tapped">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <fa:FontIcon Glyph="&#xE9D2;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="函数图像" FontSize="14" FontWeight="SemiBold" />
                            <!-- 上游写的是「函数曲线、圆锥曲线与几何作图」（网页版能力）；本地这一页是原生
                                 函数曲线 + 闭式性质分析，没有几何作图，副标题按本机实际能力写。 -->
                            <TextBlock Text="函数曲线绘制与性质分析" FontSize="12" Opacity="0.65" />
                        </StackPanel>
                        <fa:FontIcon Grid.Column="2" Margin="16,0,0,0" Glyph="&#xE8A7;" FontSize="12" VerticalAlignment="Center" Opacity="0.7" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 第三行快速入口：侧边布局 / 实验性功能（跟上面一排同样的两张等大卡片、同样的图标口径） -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Classes="card" Tag="sidebar" CornerRadius="8" Padding="14,18"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Tapped="Card_Tapped">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <fa:FontIcon Glyph="&#xE8A0;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="侧边布局" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="调整侧边栏的位置与模式" FontSize="12" Opacity="0.65" />
                        </StackPanel>
                        <fa:FontIcon Grid.Column="2" Margin="16,0,0,0" Glyph="&#xE8A7;" FontSize="12" VerticalAlignment="Center" Opacity="0.7" />
                    </Grid>
                </Border>

                <!--
                  实验性功能卡片故意不列它下面有什么：
                  首页只提示"这里有一组还没成熟的功能"，具体内容进去看，
                  副标题保持中性口径，不剧透任何条目名。
                -->
                <Border Grid.Column="1" Margin="8,0,0,0" Classes="card" Tag="experimental" CornerRadius="8" Padding="14,18"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Tapped="Card_Tapped">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <fa:FontIcon Glyph="&#xEA80;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="实验性功能" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="尚未成熟的新功能" FontSize="12" Opacity="0.65" />
                        </StackPanel>
                        <fa:FontIcon Grid.Column="2" Margin="16,0,0,0" Glyph="&#xE8A7;" FontSize="12" VerticalAlignment="Center" Opacity="0.7" />
                    </Grid>
                </Border>
            </Grid>

            <!--
              第三行：提交软件 / 反馈中心 —— 这两个是一对（都是"往维护者那边送东西"），所以并排。
              设置永远排在最后一张，加新卡片就往它前面插。
              约定：导航栏上半区有什么，首页就得有对应的卡片（除非特别说明）。
            -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Classes="card" Tag="submit" CornerRadius="8" Padding="14,18"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Tapped="Card_Tapped">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <fa:FontIcon Glyph="&#xE898;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="提交软件" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="把手上的软件推给更多同学" FontSize="12" Opacity="0.65" />
                        </StackPanel>
                        <fa:FontIcon Grid.Column="2" Margin="16,0,0,0" Glyph="&#xE8A7;" FontSize="12" VerticalAlignment="Center" Opacity="0.7" />
                    </Grid>
                </Border>

                <!-- 反馈中心：图标口径跟导航栏那条一致（E939 = 人 + 对话泡） -->
                <Border Grid.Column="1" Margin="8,0,0,0" Classes="card" Tag="feedback" CornerRadius="8" Padding="14,18"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Tapped="Card_Tapped">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <fa:FontIcon Glyph="&#xE939;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="反馈中心" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="问题与建议都写在这里" FontSize="12" Opacity="0.65" />
                        </StackPanel>
                        <fa:FontIcon Grid.Column="2" Margin="16,0,0,0" Glyph="&#xE8A7;" FontSize="12" VerticalAlignment="Center" Opacity="0.7" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 设置：必须永远在最后一张，反馈中心进来后这一行放不下第三个，所以它单独占一行 -->
            <Border Margin="0,8,0,0" Classes="card" Tag="settings" CornerRadius="8" Padding="14,18"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Tapped="Card_Tapped">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <fa:FontIcon Glyph="&#xE713;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="设置" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="更新、内容源与外观" FontSize="12" Opacity="0.65" />
                    </StackPanel>
                    <fa:FontIcon Grid.Column="2" Margin="16,0,0,0" Glyph="&#xE8A7;" FontSize="12" VerticalAlignment="Center" Opacity="0.7" />
                </Grid>
            </Border>

            <!-- ===== 收录情况（InfoBar）=====
                 「已收录」与「今日新增」同住这一条，贴在设置卡片正下方、快捷入口之上。
                 标题 = 已收录 N 款软件（常驻：只要清单同步下来就显示）；
                 正文 = 今日新增 N 款：具体是哪几款（只有算出 >0 时才有，平时是空串）。
                 IsClosable=False —— 常驻信息，关掉就没地方看数字。
                 默认 IsOpen=False，由 code-behind 的 RefreshCollectedCount() 按"清单到没到"决定。
                 不显示「今日新增 0 款」占位。 -->
            <fa:InfoBar x:Name="CollectedBar" IsOpen="False" IsClosable="False"
                        Severity="Informational" Margin="0,4,0,0" />

            <!-- ===== 一行快捷入口：图标在上、文字在下（不用卡片、不加标题） =====
                 移植说明：原版是 GridView + ItemsWrapGrid(ItemWidth 192 / ItemHeight 88)。
                 Avalonia 用 ItemsControl + WrapPanel（ItemWidth/ItemHeight 同值）还原；
                 GridView 的 IsItemClickEnabled + ItemClick → 这里用 Tapped 冒泡（点在卡片上冒到 ItemsControl）。 -->
            <ItemsControl x:Name="QuickGrid" Margin="0,14,0,0"
                          ItemTemplate="{StaticResource QuickLinkSelector}"
                          Tapped="QuickGrid_Tapped">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="192" ItemHeight="88" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- ===== 硬件信息 / 系统信息：列表形式（不用卡片），行在 code-behind 里填 ===== -->
            <TextBlock Text="硬件信息" FontSize="20" FontWeight="Bold" Margin="0,20,0,2" />
            <StackPanel x:Name="HardwareList" Margin="2,0,0,0" />

            <TextBlock Text="系统信息" FontSize="20" FontWeight="Bold" Margin="0,22,0,2" />
            <StackPanel x:Name="SystemList" Margin="2,0,0,0" />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</platform:PageBase>
