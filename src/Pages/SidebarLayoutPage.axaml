<platform:PageBase
    x:Class="ClassSoftwareHub.Desktop.Pages.SidebarLayoutPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platform="using:ClassSoftwareHub.Desktop.Platform"
    xmlns:fa="using:FluentAvalonia.UI.Controls">

    <!--
      ⚠️ 移植说明（WinUI → Avalonia/FluentAvalonia）：
        · 根元素 Page → platform:PageBase；NavigationCacheMode="Disabled" 由
          ShellPage 的 <fa:Frame CacheSize="0"/> 统一承担。
        · 原版根 Grid 的 Padding → Avalonia 的 Grid 没有 Padding，改用 Margin（数值照搬）。
        · Grid 的 RowSpacing/ColumnSpacing 在 Avalonia 没有 → 用子元素 Margin 模拟，数值照搬。
        · 原版 ScrollViewer 的 VerticalScrollMode="Auto" 是 WinUI 触摸平移（DirectManipulation）
          的开关，Avalonia 没有对应属性 → 略去（触摸滚动行为由框架自己管）。
        · Visibility="Collapsed" → IsVisible="False"；ThemeResource → DynamicResource；
          ToolTipService.ToolTip → ToolTip.Tip。
        · 原版底部五颗 ToggleSwitch 用了 Header（Avalonia 的 ToggleSwitch 没有）→
          拆成「文字 + 开关」竖排，外观与原版一致。
    -->

    <Grid>
        <!-- ⚠️ 2026-10-03：ScrollViewer 提到最外层（滚动条贴窗口右缘），边距改 Padding、
             居中改内层 Grid 的 MaxWidth + Center；原来「右边留 18 的空」不再需要 ——
             滚动条已经贴到窗口边上，不会压着预览条 -->
        <ScrollViewer x:Name="PageScroll" Padding="24,36,24,44" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- 原版 RowSpacing="14" → 每行子元素各自带 0,0,0,14 的底边距 -->
            <Grid x:Name="WorkspaceRoot" MaxWidth="960" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="5" Margin="0,0,0,14">
                    <TextBlock Text="侧边布局" FontSize="30" FontWeight="Bold" />
                    <TextBlock FontSize="13" Opacity="0.7" TextWrapping="Wrap"
                               Text="从左侧模块库选择模块，拖入右侧侧边栏预览（亦可单击卡片添加）；在预览区拖动可调整顺序，拖出即移除。右侧即侧边栏的实际效果。触摸屏操作：按住卡片约半秒且手指不移动即可拖动；直接滑动则为滚动整页。" />
                </StackPanel>

                <!-- 原版 ColumnSpacing="22" → 右列 StackPanel 左边距 22 -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：模块库 -->
                    <!-- 原版 RowSpacing="10" → 标题行自带底边距 -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                    Margin="0,0,0,10">
                            <TextBlock Text="模块库" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="拖入右侧，或单击卡片" FontSize="12" Opacity="0.6"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel x:Name="LibraryPanel" Grid.Row="1" Spacing="10" Margin="0,2,0,0" />
                    </Grid>

                    <!-- 右：侧边栏预览（宽度照真实侧边栏来，所见即所得） -->
                    <StackPanel Grid.Column="1" Margin="22,0,0,0" Spacing="8">
                        <TextBlock Text="侧边栏预览" FontSize="16" FontWeight="Bold" />

                        <Border x:Name="PreviewStrip" Width="240" CornerRadius="10" Padding="4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                <!-- 让位的"空档"画在这一层：它**不参与布局**，所以空档挪位置时不会有哪一行被布局瞬间顶走
                                     （之前是往下面的 StackPanel 里插/移一个 spacer，跨过一行那一行就跳一格）。
                                     放在行**下面**，行滑过去时正好把空档盖住，看着就是"缝被填上了"。 -->
                                <Canvas x:Name="HoleLayer" IsHitTestVisible="False" />

                                <!-- 模块那一摞。行的位置**固定不动**，让位靠每行自己的 Margin 偏移补间。
                                     侧边栏自带的那三个键（收起/位置复原/隐藏）这里不画 —— 它们本来就不能拼、不能删，
                                     摆在这儿只会挤位置、也是多余的。 -->
                                <StackPanel x:Name="PreviewPanel" Spacing="3" />
                            </Grid>
                        </Border>

                        <TextBlock FontSize="11.5" Opacity="0.6" Width="240" TextWrapping="Wrap"
                                   Text="右侧三个按钮：上移 / 下移 / 移除。将模块拖出后松手亦可移除。" />
                    </StackPanel>
                </Grid>

                <!-- 侧边栏自带的那排底部按钮（收起 / 常驻 / 位置复原 / 隐藏 / 打开应用）——
                     **五颗各自一个开关**，横排。开关只管显示与否，不改变它们在侧边栏里的先后。
                     ⚠️ IsChecked 一律**不在 XAML 里写死**（原版同理不写死 IsOn），
                        由 Refresh() 从设置同步过来。
                     ⚠️ 五颗的 `Tag` 必须跟 SidebarFooterKeys 里的字面量一致（那是存档格式的一部分）。
                     ⚠️ Avalonia 的 ToggleSwitch 没有 Header → 用「文字 + 开关」竖排还原。 -->
                <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,14">
                    <TextBlock Text="侧边栏底部按钮" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,-2,0,2"
                               Text="侧边栏展开面板底部自带的一排按钮，逐颗控制显示与隐藏；侧边栏按实际显示的颗数收缩。" />
                    <!-- 原版 ColumnSpacing="8" → 第 2~5 列各带 8 的左边距 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="0">
                            <TextBlock Text="收起" FontSize="12" Opacity="0.8" Margin="0,0,0,2" />
                            <ToggleSwitch x:Name="FoldToggle" Tag="fold"
                                          OnContent="显示" OffContent="隐藏" IsCheckedChanged="FooterItem_Toggled" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="0">
                            <TextBlock Text="常驻" FontSize="12" Opacity="0.8" Margin="0,0,0,2" />
                            <ToggleSwitch x:Name="PinToggle" Tag="pin"
                                          OnContent="显示" OffContent="隐藏" IsCheckedChanged="FooterItem_Toggled" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,0,0,0" Spacing="0">
                            <TextBlock Text="位置复原" FontSize="12" Opacity="0.8" Margin="0,0,0,2" />
                            <ToggleSwitch x:Name="ResetToggle" Tag="reset"
                                          OnContent="显示" OffContent="隐藏" IsCheckedChanged="FooterItem_Toggled" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="8,0,0,0" Spacing="0">
                            <TextBlock Text="隐藏" FontSize="12" Opacity="0.8" Margin="0,0,0,2" />
                            <ToggleSwitch x:Name="HideToggle" Tag="hide"
                                          OnContent="显示" OffContent="隐藏" IsCheckedChanged="FooterItem_Toggled" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="8,0,0,0" Spacing="0">
                            <TextBlock Text="打开应用" FontSize="12" Opacity="0.8" Margin="0,0,0,2" />
                            <ToggleSwitch x:Name="OpenAppToggle" Tag="openapp"
                                          OnContent="显示" OffContent="隐藏" IsCheckedChanged="FooterItem_Toggled" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- 原版 ColumnSpacing="16" → 右侧按钮组左边距 16 -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock FontSize="12.5" Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="可不放置任何模块，此时侧边栏仅保留自带的按钮。侧边栏开关位于「设置 → 常用工具」中。" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
                        <Button x:Name="SidebarButton" Content="隐藏侧边栏" Click="ToggleSidebar_Click" />
                        <Button Content="恢复默认" Click="ResetDefault_Click"
                                ToolTip.Tip="恢复为「抽号 / 计时 / 秒表 / 时钟」四个模块" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- 把预览里的模块拖到空白处时浮出来的提示 -->
        <Border x:Name="RemoveHint" IsVisible="False"
                CornerRadius="8" Padding="16,10"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <fa:FontIcon Glyph="&#xE74D;" FontSize="14"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="松手即从侧边栏移除" />
            </StackPanel>
        </Border>

        <!-- 拖着走的那张卡就放在这层上面（不吃点击） -->
        <Canvas x:Name="DragLayer" Grid.ColumnSpan="3" IsHitTestVisible="False" />
    </Grid>
</platform:PageBase>
