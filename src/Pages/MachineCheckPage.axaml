<platform:PageBase
    x:Class="ClassSoftwareHub.Desktop.Pages.MachineCheckPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platform="using:ClassSoftwareHub.Desktop.Platform"
    xmlns:fa="using:FluentAvalonia.UI.Controls"
    xmlns:local="using:ClassSoftwareHub.Desktop.Pages">

    <!--
      ⚠️ 移植说明（WinUI → Avalonia/FluentAvalonia）：
        · 原版 Page 根元素上的 NavigationCacheMode="Disabled" —— Avalonia 侧由
          ShellPage 的 <fa:Frame CacheSize="0"/> 统一承担，这里不再单设。
        · 原版 GridView（IsItemClickEnabled + ItemClick + CshCardItemStyle）→
          ItemsControl + WrapPanel + Tapped 冒泡（与首页/实验性功能页同一套写法）；
          容器悬停反馈 → 卡片 :pointerover 伪类改 Opacity（原版是 PointerEntered/Exited 事件）。
        · x:Bind → {Binding}；ThemeResource → DynamicResource；ToolTipService.ToolTip → ToolTip.Tip；
          Visibility 枚举 → bool IsVisible（占位字形的 PlaceholderVisibility → PlaceholderVisible）。

      卡片容器样式（关掉容器自带的焦点框/悬停底色）在原版是 App.xaml 里的 CshCardItemStyle；
      ItemsControl 没有容器，样式随卡片一起内联在模板里。

      和首页 / 软件下载 / 设置同一套版式：三列 Grid 把内容钉在中间 960 宽（导航展开收起都不动）。
      ⚠️ 别用 Stretch + MaxWidth：一旦触发上限 WinUI 会把整列右甩。

      版式取舍（2026-09-26 Nick 反馈"一大块区域只有一小条能滚"）：
      统计从"独立大卡片"压成一行工具栏、筛选并到同一行、列表改 3 列卡片网格 ——
      可视条目从一屏约 4 条提到 12 条，纵向空间几乎全留给列表。
      ⚠️ 原版内层 Grid 的 RowSpacing="14" → 第 1、2、3 行各加 Margin="0,14,0,0"
         （列表行还并入了原版 GridView 的 Padding="0,2,0,0" → 16）。
    -->
    <platform:PageBase.Styles>
        <Style Selector="Border.card:pointerover">
            <Setter Property="Opacity" Value="0.88" />
        </Style>
    </platform:PageBase.Styles>

    <!-- ⚠️ 2026-10-02：ScrollViewer 提到最外层（滚动条贴窗口右缘），边距改 Padding、居中改内层 Grid；
         原来套在列表外面的那层 ScrollViewer 解开（「检测中 / 空状态」跟着外层一起滚） -->
    <ScrollViewer Padding="24,36,24,44" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="960" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 + 实验性标记：本页结论**明显不准**，必须在第一眼就讲清楚，
                 免得被当成装机验收依据（页面只藏在「实验性功能」下面还不够，进来也得看见） -->
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="本机核实" FontSize="30" FontWeight="Bold" />
                    <Border CornerRadius="5" Padding="8,3" Margin="0,0,0,6" VerticalAlignment="Bottom"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SystemFillColorCautionBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <fa:FontIcon Glyph="&#xEA80;" FontSize="11"
                                         Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="实验性功能" FontSize="11.5"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock FontSize="12.5" Opacity="0.65" TextWrapping="Wrap"
                           Text="对照软件清单核实本机安装情况，列出未安装与建议升级的软件。检测依据为 Windows 已安装程序记录；Microsoft Store 应用与免安装版不在记录中，可能显示为「未安装」。" />
            </StackPanel>

            <!-- 工具栏：左边统计，右边筛选（合成一行，把纵向空间让给列表） -->
            <Border Grid.Row="1" Margin="0,14,0,0" CornerRadius="8" Padding="18,12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <!-- Grid 无 ColumnSpacing=16 → 第 1 列加 16 左 Margin 模拟 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="22" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="StatTotal" Text="—" FontSize="19" FontWeight="Bold" />
                            <TextBlock Text="条清单" FontSize="12" Opacity="0.6"
                                       VerticalAlignment="Bottom" Margin="0,0,0,3" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="StatInstalled" Text="—" FontSize="19" FontWeight="Bold" />
                            <TextBlock Text="已安装" FontSize="12" Opacity="0.6"
                                       VerticalAlignment="Bottom" Margin="0,0,0,3" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="StatOutdated" Text="—" FontSize="19" FontWeight="Bold"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="建议升级" FontSize="12" Opacity="0.6"
                                       VerticalAlignment="Bottom" Margin="0,0,0,3" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="StatMissing" Text="—" FontSize="19" FontWeight="Bold" />
                            <TextBlock Text="未安装" FontSize="12" Opacity="0.6"
                                       VerticalAlignment="Bottom" Margin="0,0,0,3" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <ComboBox x:Name="FilterBox" Width="150" SelectionChanged="Filter_Changed" />
                        <TextBlock x:Name="CountText" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 列表：3 列卡片网格（302 + 16 间距 = 正好 960，和「软件下载」磁贴同一尺寸） -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <!-- ⚠️ 列表（2026-10-02：原版 GridView 自带滚动，换成 ItemsControl 后
                     结果一多就被裁掉且滚不动。2026-10-02 起由页面最外层 ScrollViewer 统一管滚动。） -->
                <ItemsControl x:Name="ResultGrid" Tapped="Result_ItemClick">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="302" Height="108" CornerRadius="8" Padding="16,14" Margin="0,0,16,14"
                                    Classes="card"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <!-- Grid 无 ColumnSpacing=12 → 第 1 列加 12 左 Margin 模拟 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 图标：圆角由 Border 的 ImageBrush 裁出来（和「软件下载」同一手法）。
                                         ⚠️ 2026-10-02：直接绑 Item.App 的两个属性，这样图标异步下完
                                            会由 SoftwareApp 的 PropertyChanged 驱动界面自己换上；
                                            下不来时是**彩色首字头像**，不再是灰字形。 -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="9"
                                            VerticalAlignment="Top">
                                        <Border.Background>
                                            <ImageBrush Source="{Binding Item.App.IconImage}" Stretch="UniformToFill" />  <!-- Avalonia 的 ImageBrush 属性名是 Source -->
                                        </Border.Background>
                                        <Border Background="{Binding Item.App.AvatarBrush}"
                                                IsVisible="{Binding Item.App.IconPlaceholder}">
                                            <TextBlock Text="{Binding Item.App.AvatarText}" FontSize="17" FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="4">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border CornerRadius="4" Padding="7,1" BorderThickness="1"
                                                    BorderBrush="{Binding StatusBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                           Foreground="{Binding StatusBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding VersionText}" FontSize="11.5" Opacity="0.7"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Note}" FontSize="11.5" Opacity="0.6"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Note}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 检测中 -->
                <StackPanel x:Name="LoadingPanel" Spacing="12" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <fa:ProgressRing IsActive="True" Width="34" Height="34" HorizontalAlignment="Center" />
                    <TextBlock Text="正在读取本机已安装的软件" FontSize="13" Opacity="0.7"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 空状态 -->
                <StackPanel x:Name="EmptyPanel" Spacing="10" IsVisible="False"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <fa:FontIcon Glyph="&#xE7F4;" FontSize="34" Opacity="0.45" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyText" Text="当前筛选条件下没有软件" FontSize="14" Opacity="0.7"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 底部：重测 + 概览 + 口径说明 -->
            <StackPanel Grid.Row="3" Margin="0,14,0,0" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="RescanButton" Content="重新检测" Click="Rescan_Click" />
                    <Button Content="打开软件下载" Click="GoApps_Click" />
                    <TextBlock x:Name="SummaryHint" FontSize="12" Opacity="0.7" MaxLines="1"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="FootNote" FontSize="11.5" Opacity="0.55" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</platform:PageBase>
